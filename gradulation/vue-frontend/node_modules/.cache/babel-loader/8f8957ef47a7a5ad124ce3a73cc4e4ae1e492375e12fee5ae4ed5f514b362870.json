{"ast":null,"code":"import { ref } from 'vue';\nimport { ArrowLeft, Headset, VideoPlay, VideoPause, Back, Right } from '@element-plus/icons-vue';\nimport { ElMessage } from 'element-plus';\nexport default {\n  __name: 'MusicGeneration',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const prompt = ref('');\n    const genres = ['流行', '摇滚', 'Lo-Fi', '爵士', '电子', '古典', '环境音'];\n    const selectedGenre = ref('');\n    const isGenerating = ref(false);\n    const resultAudio = ref(false);\n    const isPlaying = ref(false);\n    const currentTime = ref(0);\n    const handleGenerate = () => {\n      if (!prompt.value) return ElMessage.warning('请描述你想要的音乐');\n      isGenerating.value = true;\n      resultAudio.value = false;\n      isPlaying.value = false;\n      setTimeout(() => {\n        isGenerating.value = false;\n        resultAudio.value = true;\n        isPlaying.value = true; // 自动播放\n        ElMessage.success('音乐生成完成！');\n        simulateProgress();\n      }, 2500);\n    };\n    const togglePlay = () => {\n      isPlaying.value = !isPlaying.value;\n    };\n\n    // 简单的进度条模拟\n    const simulateProgress = () => {\n      currentTime.value = 0;\n      const timer = setInterval(() => {\n        if (!isPlaying.value) return;\n        if (currentTime.value >= 100) {\n          isPlaying.value = false;\n          currentTime.value = 0;\n          clearInterval(timer);\n        } else {\n          currentTime.value += 1;\n        }\n      }, 100);\n    };\n    const formatTime = val => {\n      return val + '%';\n    };\n    const __returned__ = {\n      prompt,\n      genres,\n      selectedGenre,\n      isGenerating,\n      resultAudio,\n      isPlaying,\n      currentTime,\n      handleGenerate,\n      togglePlay,\n      simulateProgress,\n      formatTime,\n      ref,\n      get ArrowLeft() {\n        return ArrowLeft;\n      },\n      get Headset() {\n        return Headset;\n      },\n      get VideoPlay() {\n        return VideoPlay;\n      },\n      get VideoPause() {\n        return VideoPause;\n      },\n      get Back() {\n        return Back;\n      },\n      get Right() {\n        return Right;\n      },\n      get ElMessage() {\n        return ElMessage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","ArrowLeft","Headset","VideoPlay","VideoPause","Back","Right","ElMessage","prompt","genres","selectedGenre","isGenerating","resultAudio","isPlaying","currentTime","handleGenerate","value","warning","setTimeout","success","simulateProgress","togglePlay","timer","setInterval","clearInterval","formatTime","val"],"sources":["C:/Users/11395/Desktop/design-graduation/gradulation/vue-frontend/src/views/MusicGeneration.vue"],"sourcesContent":["<template>\r\n  <div class=\"page-container music-theme\">\r\n    <el-header class=\"header\">\r\n      <div class=\"left\">\r\n        <el-button link @click=\"$router.back()\" class=\"back-btn\">\r\n          <el-icon><ArrowLeft /></el-icon> 返回\r\n        </el-button>\r\n        <h2>AI 音乐创作</h2>\r\n      </div>\r\n    </el-header>\r\n\r\n    <el-main class=\"main-content\">\r\n      <div class=\"music-studio\">\r\n        <!-- 顶部输入区 -->\r\n        <div class=\"input-section glass-card\">\r\n          <div class=\"input-row\">\r\n            <el-input\r\n              v-model=\"prompt\"\r\n              placeholder=\"描述你想听到的音乐：例如'雨中悲伤的钢琴曲' 或 '充满活力的赛博朋克电子乐'\"\r\n              class=\"music-input\"\r\n              clearable\r\n            >\r\n              <template #prefix>\r\n                <el-icon><Headset /></el-icon>\r\n              </template>\r\n            </el-input>\r\n            <el-button type=\"primary\" size=\"large\" @click=\"handleGenerate\" :loading=\"isGenerating\">\r\n              生成音乐\r\n            </el-button>\r\n          </div>\r\n          \r\n          <div class=\"tags-row\">\r\n            <el-tag \r\n              v-for=\"tag in genres\" \r\n              :key=\"tag\" \r\n              class=\"genre-tag\" \r\n              :effect=\"selectedGenre === tag ? 'dark' : 'plain'\"\r\n              @click=\"selectedGenre = tag\"\r\n            >\r\n              {{ tag }}\r\n            </el-tag>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 中部：可视化与播放器 -->\r\n        <div class=\"player-section glass-card\">\r\n          <div class=\"visualizer\">\r\n            <!-- 模拟波形动画 -->\r\n            <div class=\"bars\" :class=\"{ 'playing': isPlaying }\">\r\n              <div class=\"bar\" v-for=\"n in 20\" :key=\"n\" :style=\"{ animationDelay: `-${Math.random()}s` }\"></div>\r\n            </div>\r\n            <div class=\"status-text\">\r\n              <span v-if=\"isGenerating\">AI正在作曲中...</span>\r\n              <span v-else-if=\"resultAudio\">《{{ prompt || '未命名音轨' }}》</span>\r\n              <span v-else>等待生成...</span>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- 播放控制条 -->\r\n          <div class=\"controls\" v-if=\"resultAudio\">\r\n            <el-slider v-model=\"currentTime\" :max=\"100\" :format-tooltip=\"formatTime\" />\r\n            <div class=\"btns\">\r\n  <!-- 1. icon=\"Back\" 改为 :icon=\"Back\" -->\r\n            <el-button circle :icon=\"Back\" />\r\n            <el-button circle size=\"large\" type=\"primary\" @click=\"togglePlay\">\r\n    <!-- 2. 去掉 'VideoPause' 的单引号，直接用变量 VideoPause -->\r\n            <el-icon size=\"24\">\r\n            <component :is=\"isPlaying ? VideoPause : VideoPlay\" />\r\n        </el-icon>\r\n  </el-button>\r\n  \r\n  <!-- 3. icon=\"Right\" 改为 :icon=\"Right\" -->\r\n  <el-button circle :icon=\"Right\" />\r\n</div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </el-main>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref } from 'vue'\r\nimport { ArrowLeft, Headset, VideoPlay, VideoPause, Back, Right } from '@element-plus/icons-vue'\r\nimport { ElMessage } from 'element-plus'\r\n\r\nconst prompt = ref('')\r\nconst genres = ['流行', '摇滚', 'Lo-Fi', '爵士', '电子', '古典', '环境音']\r\nconst selectedGenre = ref('')\r\nconst isGenerating = ref(false)\r\nconst resultAudio = ref(false)\r\nconst isPlaying = ref(false)\r\nconst currentTime = ref(0)\r\n\r\nconst handleGenerate = () => {\r\n  if (!prompt.value) return ElMessage.warning('请描述你想要的音乐')\r\n  \r\n  isGenerating.value = true\r\n  resultAudio.value = false\r\n  isPlaying.value = false\r\n  \r\n  setTimeout(() => {\r\n    isGenerating.value = false\r\n    resultAudio.value = true\r\n    isPlaying.value = true // 自动播放\r\n    ElMessage.success('音乐生成完成！')\r\n    simulateProgress()\r\n  }, 2500)\r\n}\r\n\r\nconst togglePlay = () => {\r\n  isPlaying.value = !isPlaying.value\r\n}\r\n\r\n// 简单的进度条模拟\r\nconst simulateProgress = () => {\r\n  currentTime.value = 0\r\n  const timer = setInterval(() => {\r\n    if (!isPlaying.value) return\r\n    if (currentTime.value >= 100) {\r\n      isPlaying.value = false\r\n      currentTime.value = 0\r\n      clearInterval(timer)\r\n    } else {\r\n      currentTime.value += 1\r\n    }\r\n  }, 100)\r\n}\r\n\r\nconst formatTime = (val) => {\r\n  return val + '%'\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.music-theme {\r\n  background: linear-gradient(to right, #434343 0%, black 100%);\r\n}\r\n\r\n.page-container {\r\n  min-height: 100vh;\r\n  color: white;\r\n}\r\n\r\n.header {\r\n  background: rgba(255, 255, 255, 0.05);\r\n  backdrop-filter: blur(10px);\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.main-content {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.music-studio {\r\n  width: 100%;\r\n  max-width: 800px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 30px;\r\n}\r\n\r\n.glass-card {\r\n  background: rgba(255, 255, 255, 0.08);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 20px;\r\n  padding: 30px;\r\n  border: 1px solid rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n/* 输入区域 */\r\n.input-row {\r\n  display: flex;\r\n  gap: 15px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n:deep(.music-input .el-input__wrapper) {\r\n  background: rgba(0,0,0,0.3);\r\n  border-radius: 50px;\r\n  padding-left: 20px;\r\n  box-shadow: none;\r\n  border: 1px solid #555;\r\n}\r\n\r\n:deep(.music-input .el-input__inner) {\r\n  color: white;\r\n  height: 50px;\r\n  font-size: 16px;\r\n}\r\n\r\n.tags-row {\r\n  display: flex;\r\n  gap: 10px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.genre-tag {\r\n  cursor: pointer;\r\n  border-radius: 20px;\r\n  padding: 0 20px;\r\n  height: 32px;\r\n  line-height: 30px;\r\n  transition: all 0.3s;\r\n}\r\n\r\n.genre-tag:hover {\r\n  transform: scale(1.1);\r\n}\r\n\r\n/* 播放器区域 */\r\n.player-section {\r\n  min-height: 300px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n}\r\n\r\n.visualizer {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 20px;\r\n  min-height: 150px;\r\n}\r\n\r\n.status-text {\r\n  font-size: 18px;\r\n  font-weight: 300;\r\n  color: #aeb6bf;\r\n  letter-spacing: 2px;\r\n}\r\n\r\n/* 简单的CSS音乐波形动画 */\r\n.bars {\r\n  display: flex;\r\n  align-items: flex-end;\r\n  height: 60px;\r\n  gap: 6px;\r\n}\r\n\r\n.bar {\r\n  width: 8px;\r\n  background: linear-gradient(to top, #4facfe 0%, #00f2fe 100%);\r\n  border-radius: 5px;\r\n  height: 5px;\r\n  transition: height 0.2s;\r\n}\r\n\r\n.bars.playing .bar {\r\n  animation: equalize 1s infinite ease-in-out;\r\n}\r\n\r\n@keyframes equalize {\r\n  0% { height: 10px; }\r\n  50% { height: 50px; }\r\n  100% { height: 10px; }\r\n}\r\n\r\n/* 底部控制条 */\r\n.controls {\r\n  margin-top: 30px;\r\n  padding: 0 20px;\r\n}\r\n\r\n.btns {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 20px;\r\n  margin-top: 15px;\r\n}\r\n</style>"],"mappings":"AAkFA,SAASA,GAAG,QAAQ,KAAK;AACzB,SAASC,SAAS,EAAEC,OAAO,EAAEC,SAAS,EAAEC,UAAU,EAAEC,IAAI,EAAEC,KAAK,QAAQ,