{"ast":null,"code":"import { ref, computed, reactive, onUnmounted } from 'vue';\nimport { ArrowLeft, EditPen, VideoPlay, Download } from '@element-plus/icons-vue';\nimport { ElMessage } from 'element-plus';\nimport axios from 'axios'; // 假设你已经配置好了 axios 拦截器处理 token\n\n// 表单数据，对应后端的 VideoGenerateReq 结构体\n\nexport default {\n  __name: 'VideoGeneration',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const form = reactive({\n      prompt: '',\n      quality: 'quality',\n      // 默认高质量\n      duration: 5,\n      // 默认5秒\n      with_audio: true // 默认开启音效\n    });\n    const isGenerating = ref(false);\n    const resultVideo = ref('');\n    const statusText = ref(''); // PENDING, PROCESSING...\n    const failReason = ref('');\n    let pollTimer = null;\n    const btnText = computed(() => {\n      if (isGenerating.value) return 'AI 正在渲染中...';\n      return '开始生成视频';\n    });\n\n    // 提交生成任务\n    const handleGenerate = async () => {\n      if (!form.prompt) return ElMessage.warning('请输入视频描述');\n      isGenerating.value = true;\n      resultVideo.value = '';\n      failReason.value = '';\n      statusText.value = '提交中...';\n      try {\n        // 1. 调用后端生成接口\n        const res = await axios.post('/api/v1/video/generate', form);\n        if (res.data.code === 1000) {\n          const taskId = res.data.task_id;\n          ElMessage.success('任务提交成功，开始生成...');\n          // 2. 开始轮询\n          startPolling(taskId);\n        } else {\n          ElMessage.error(res.data.msg || '提交失败');\n          isGenerating.value = false;\n        }\n      } catch (error) {\n        console.error(error);\n        ElMessage.error('网络请求失败');\n        isGenerating.value = false;\n      }\n    };\n\n    // 轮询查询状态\n    const startPolling = taskId => {\n      pollTimer = setInterval(async () => {\n        try {\n          const res = await axios.get(`/api/v1/video/status/${taskId}`);\n          if (res.data.code === 1000) {\n            const data = res.data.data;\n            statusText.value = data.status; // 更新界面上的状态文字\n\n            if (data.status === 'SUCCESS') {\n              // 成功\n              clearInterval(pollTimer);\n              resultVideo.value = data.video_url;\n              isGenerating.value = false;\n              ElMessage.success('视频生成完成！');\n            } else if (data.status === 'FAIL') {\n              // 失败\n              clearInterval(pollTimer);\n              isGenerating.value = false;\n              failReason.value = data.fail_error;\n              ElMessage.error('视频生成失败: ' + data.fail_error);\n            }\n            // 如果是 PENDING 或 PROCESSING，继续轮询\n          } else {\n            // 接口返回错误码（如任务不存在）\n            clearInterval(pollTimer);\n            isGenerating.value = false;\n            ElMessage.error(res.data.msg);\n          }\n        } catch (error) {\n          // 网络错误可以不立即停止，或者设置最大重试次数\n          console.error('轮询出错', error);\n        }\n      }, 3000); // 每3秒查一次\n    };\n\n    // 下载视频\n    const downloadVideo = () => {\n      if (!resultVideo.value) return;\n      window.open(resultVideo.value, '_blank');\n    };\n\n    // 组件销毁时清除定时器\n    onUnmounted(() => {\n      if (pollTimer) clearInterval(pollTimer);\n    });\n    const __returned__ = {\n      form,\n      isGenerating,\n      resultVideo,\n      statusText,\n      failReason,\n      get pollTimer() {\n        return pollTimer;\n      },\n      set pollTimer(v) {\n        pollTimer = v;\n      },\n      btnText,\n      handleGenerate,\n      startPolling,\n      downloadVideo,\n      ref,\n      computed,\n      reactive,\n      onUnmounted,\n      get ArrowLeft() {\n        return ArrowLeft;\n      },\n      get EditPen() {\n        return EditPen;\n      },\n      get VideoPlay() {\n        return VideoPlay;\n      },\n      get Download() {\n        return Download;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","reactive","onUnmounted","ArrowLeft","EditPen","VideoPlay","Download","ElMessage","axios","form","prompt","quality","duration","with_audio","isGenerating","resultVideo","statusText","failReason","pollTimer","btnText","value","handleGenerate","warning","res","post","data","code","taskId","task_id","success","startPolling","error","msg","console","setInterval","get","status","clearInterval","video_url","fail_error","downloadVideo","window","open"],"sources":["C:/Users/11395/Desktop/design-graduation/gradulation/vue-frontend/src/views/VideoGeneration.vue"],"sourcesContent":["<template>\r\n  <div class=\"page-container\">\r\n    <!-- 顶部导航 -->\r\n    <el-header class=\"header\">\r\n      <div class=\"left\">\r\n        <el-button link @click=\"$router.back()\" class=\"back-btn\">\r\n          <el-icon><ArrowLeft /></el-icon> 返回\r\n        </el-button>\r\n        <h2>AI 视频生成</h2>\r\n      </div>\r\n    </el-header>\r\n\r\n    <el-main class=\"main-content\">\r\n      <div class=\"content-wrapper\">\r\n        <!-- 左侧：控制面板 -->\r\n        <div class=\"control-panel glass-card\">\r\n          <h3><el-icon><EditPen /></el-icon> 创作描述</h3>\r\n          <el-input\r\n            v-model=\"form.prompt\"\r\n            type=\"textarea\"\r\n            :rows=\"6\"\r\n            placeholder=\"例如：一只赛博朋克风格的猫在霓虹灯闪烁的雨夜街道上行走，超高清，电影质感...\"\r\n            class=\"custom-input\"\r\n          />\r\n          \r\n          <div class=\"settings-grid\">\r\n            <div class=\"setting-item\">\r\n              <span class=\"label\">画质优先</span>\r\n              <el-select v-model=\"form.quality\" class=\"custom-select\">\r\n                <el-option label=\"高质量 (Quality)\" value=\"quality\" />\r\n                <el-option label=\"极速 (Speed)\" value=\"speed\" />\r\n              </el-select>\r\n            </div>\r\n            <div class=\"setting-item\">\r\n              <span class=\"label\">时长 (秒)</span>\r\n              <el-radio-group v-model=\"form.duration\" size=\"small\">\r\n                <el-radio-button :label=\"5\">5s</el-radio-button>\r\n                <el-radio-button :label=\"10\">10s</el-radio-button>\r\n              </el-radio-group>\r\n            </div>\r\n          </div>\r\n\r\n           <div class=\"setting-item\" style=\"margin-top: 15px;\">\r\n              <el-checkbox v-model=\"form.with_audio\" label=\"生成音效 (With Audio)\"/>\r\n           </div>\r\n\r\n          <el-button \r\n            type=\"primary\" \r\n            class=\"generate-btn\" \r\n            :loading=\"isGenerating\"\r\n            @click=\"handleGenerate\"\r\n          >\r\n            {{ btnText }}\r\n          </el-button>\r\n        </div>\r\n\r\n        <!-- 右侧：预览/结果区域 -->\r\n        <div class=\"preview-panel glass-card\">\r\n          <!-- 初始状态 -->\r\n          <div v-if=\"!resultVideo && !isGenerating\" class=\"empty-state\">\r\n            <el-icon size=\"60\"><VideoPlay /></el-icon>\r\n            <p>生成的视频将在这里播放</p>\r\n          </div>\r\n\r\n          <!-- 生成中状态 -->\r\n          <div v-if=\"isGenerating\" class=\"loading-state\">\r\n            <div class=\"loader\"></div>\r\n            <p>正在生成中，请稍候...</p>\r\n            <p class=\"status-text\">当前状态: {{ statusText }}</p>\r\n          </div>\r\n\r\n          <!-- 结果展示 -->\r\n          <div v-if=\"resultVideo\" class=\"video-result\">\r\n            <video controls autoplay loop :src=\"resultVideo\" class=\"result-player\"></video>\r\n            <div class=\"actions\">\r\n              <el-button type=\"success\" :icon=\"Download\" round @click=\"downloadVideo\">下载视频</el-button>\r\n            </div>\r\n            <div v-if=\"failReason\" class=\"error-msg\">\r\n                生成失败: {{ failReason }}\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </el-main>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, computed, reactive, onUnmounted } from 'vue'\r\nimport { ArrowLeft, EditPen, VideoPlay, Download } from '@element-plus/icons-vue'\r\nimport { ElMessage } from 'element-plus'\r\nimport axios from 'axios' // 假设你已经配置好了 axios 拦截器处理 token\r\n\r\n// 表单数据，对应后端的 VideoGenerateReq 结构体\r\nconst form = reactive({\r\n  prompt: '',\r\n  quality: 'quality', // 默认高质量\r\n  duration: 5,        // 默认5秒\r\n  with_audio: true    // 默认开启音效\r\n})\r\n\r\nconst isGenerating = ref(false)\r\nconst resultVideo = ref('')\r\nconst statusText = ref('') // PENDING, PROCESSING...\r\nconst failReason = ref('')\r\nlet pollTimer = null\r\n\r\nconst btnText = computed(() => {\r\n  if (isGenerating.value) return 'AI 正在渲染中...'\r\n  return '开始生成视频'\r\n})\r\n\r\n// 提交生成任务\r\nconst handleGenerate = async () => {\r\n  if (!form.prompt) return ElMessage.warning('请输入视频描述')\r\n  \r\n  isGenerating.value = true\r\n  resultVideo.value = ''\r\n  failReason.value = ''\r\n  statusText.value = '提交中...'\r\n\r\n  try {\r\n    // 1. 调用后端生成接口\r\n    const res = await axios.post('/api/v1/video/generate', form)\r\n    \r\n    if (res.data.code === 1000) {\r\n      const taskId = res.data.task_id\r\n      ElMessage.success('任务提交成功，开始生成...')\r\n      // 2. 开始轮询\r\n      startPolling(taskId)\r\n    } else {\r\n      ElMessage.error(res.data.msg || '提交失败')\r\n      isGenerating.value = false\r\n    }\r\n  } catch (error) {\r\n    console.error(error)\r\n    ElMessage.error('网络请求失败')\r\n    isGenerating.value = false\r\n  }\r\n}\r\n\r\n// 轮询查询状态\r\nconst startPolling = (taskId) => {\r\n  pollTimer = setInterval(async () => {\r\n    try {\r\n      const res = await axios.get(`/api/v1/video/status/${taskId}`)\r\n      \r\n      if (res.data.code === 1000) {\r\n        const data = res.data.data\r\n        statusText.value = data.status // 更新界面上的状态文字\r\n\r\n        if (data.status === 'SUCCESS') {\r\n          // 成功\r\n          clearInterval(pollTimer)\r\n          resultVideo.value = data.video_url\r\n          isGenerating.value = false\r\n          ElMessage.success('视频生成完成！')\r\n        } else if (data.status === 'FAIL') {\r\n          // 失败\r\n          clearInterval(pollTimer)\r\n          isGenerating.value = false\r\n          failReason.value = data.fail_error\r\n          ElMessage.error('视频生成失败: ' + data.fail_error)\r\n        }\r\n        // 如果是 PENDING 或 PROCESSING，继续轮询\r\n      } else {\r\n        // 接口返回错误码（如任务不存在）\r\n        clearInterval(pollTimer)\r\n        isGenerating.value = false\r\n        ElMessage.error(res.data.msg)\r\n      }\r\n    } catch (error) {\r\n      // 网络错误可以不立即停止，或者设置最大重试次数\r\n      console.error('轮询出错', error)\r\n    }\r\n  }, 3000) // 每3秒查一次\r\n}\r\n\r\n// 下载视频\r\nconst downloadVideo = () => {\r\n  if (!resultVideo.value) return\r\n  window.open(resultVideo.value, '_blank')\r\n}\r\n\r\n// 组件销毁时清除定时器\r\nonUnmounted(() => {\r\n  if (pollTimer) clearInterval(pollTimer)\r\n})\r\n</script>\r\n\r\n<style scoped>\r\n/* 样式部分大部分复用，微调细节 */\r\n.page-container {\r\n  min-height: 100vh;\r\n  background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);\r\n  color: white;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.header {\r\n  background: rgba(0, 0, 0, 0.2);\r\n  backdrop-filter: blur(10px);\r\n  display: flex;\r\n  align-items: center;\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n.back-btn {\r\n  color: white;\r\n  font-size: 16px;\r\n  margin-right: 20px;\r\n}\r\n\r\n.content-wrapper {\r\n  display: flex;\r\n  gap: 30px;\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.glass-card {\r\n  background: rgba(255, 255, 255, 0.1);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 16px;\r\n  padding: 30px;\r\n  border: 1px solid rgba(255, 255, 255, 0.2);\r\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n.control-panel {\r\n  flex: 1;\r\n  min-width: 300px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 20px;\r\n}\r\n\r\n.control-panel h3 {\r\n  margin: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.settings-grid {\r\n  display: flex;\r\n  gap: 20px;\r\n}\r\n\r\n.setting-item {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.label {\r\n    font-size: 14px;\r\n    color: rgba(255,255,255,0.8);\r\n}\r\n\r\n.generate-btn {\r\n  margin-top: 20px;\r\n  height: 50px;\r\n  font-size: 18px;\r\n  background: linear-gradient(90deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);\r\n  border: none;\r\n  color: #333;\r\n  font-weight: bold;\r\n}\r\n.generate-btn:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 5px 15px rgba(255, 154, 158, 0.4);\r\n}\r\n\r\n.preview-panel {\r\n  flex: 1.5;\r\n  min-width: 300px;\r\n  min-height: 400px;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  background: rgba(0,0,0,0.3);\r\n  position: relative;\r\n  flex-direction: column; \r\n}\r\n\r\n.empty-state, .loading-state {\r\n  text-align: center;\r\n  color: rgba(255,255,255,0.5);\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 15px;\r\n}\r\n\r\n.status-text {\r\n    font-size: 12px;\r\n    color: #ffd700;\r\n}\r\n\r\n.video-result {\r\n  width: 100%;\r\n  height: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.result-player {\r\n  width: 100%;\r\n  border-radius: 8px;\r\n  max-height: 400px;\r\n  object-fit: contain; /* 保持比例 */\r\n  box-shadow: 0 10px 30px rgba(0,0,0,0.5);\r\n  background: black;\r\n}\r\n\r\n.actions {\r\n  margin-top: 20px;\r\n  display: flex;\r\n  gap: 15px;\r\n}\r\n\r\n.error-msg {\r\n    color: #ff6b6b;\r\n    margin-top: 10px;\r\n}\r\n\r\n.loader {\r\n  width: 48px;\r\n  height: 48px;\r\n  border: 5px solid #FFF;\r\n  border-bottom-color: transparent;\r\n  border-radius: 50%;\r\n  display: inline-block;\r\n  box-sizing: border-box;\r\n  animation: rotation 1s linear infinite;\r\n}\r\n\r\n@keyframes rotation {\r\n  0% { transform: rotate(0deg); }\r\n  100% { transform: rotate(360deg); }\r\n}\r\n\r\n/* 覆盖Element UI */\r\n:deep(.el-textarea__inner), :deep(.el-input__wrapper) {\r\n  background: rgba(0,0,0,0.2) !important;\r\n  box-shadow: none !important;\r\n  color: white !important;\r\n  border: 1px solid rgba(255,255,255,0.2);\r\n}\r\n:deep(.el-select) {\r\n    width: 100%;\r\n}\r\n:deep(.el-checkbox__label) {\r\n    color: white !important;\r\n}\r\n</style>"],"mappings":"AAwFA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,QAAQ,EAAEC,WAAW,QAAQ,KAAK;AAC1D,SAASC,SAAS,EAAEC,OAAO,EAAEC,SAAS,EAAEC,QAAQ,QAAQ,yBAAyB;AACjF,SAASC,SAAS,QAAQ,cAAc;AACxC,OAAOC,KAAK,MAAM,OAAO,EAAC;;AAE1B;;;;;;;;IACA,MAAMC,IAAI,GAAGR,QAAQ,CAAC;MACpBS,MAAM,EAAE,EAAE;MACVC,OAAO,EAAE,SAAS;MAAE;MACpBC,QAAQ,EAAE,CAAC;MAAS;MACpBC,UAAU,EAAE,IAAI,CAAI;IACtB,CAAC,CAAC;IAEF,MAAMC,YAAY,GAAGf,GAAG,CAAC,KAAK,CAAC;IAC/B,MAAMgB,WAAW,GAAGhB,GAAG,CAAC,EAAE,CAAC;IAC3B,MAAMiB,UAAU,GAAGjB,GAAG,CAAC,EAAE,CAAC,EAAC;IAC3B,MAAMkB,UAAU,GAAGlB,GAAG,CAAC,EAAE,CAAC;IAC1B,IAAImB,SAAS,GAAG,IAAI;IAEpB,MAAMC,OAAO,GAAGnB,QAAQ,CAAC,MAAM;MAC7B,IAAIc,YAAY,CAACM,KAAK,EAAE,OAAO,aAAa;MAC5C,OAAO,QAAQ;IACjB,CAAC,CAAC;;IAEF;IACA,MAAMC,cAAc,GAAG,MAAAA,CAAA,KAAY;MACjC,IAAI,CAACZ,IAAI,CAACC,MAAM,EAAE,OAAOH,SAAS,CAACe,OAAO,CAAC,SAAS,CAAC;MAErDR,YAAY,CAACM,KAAK,GAAG,IAAI;MACzBL,WAAW,CAACK,KAAK,GAAG,EAAE;MACtBH,UAAU,CAACG,KAAK,GAAG,EAAE;MACrBJ,UAAU,CAACI,KAAK,GAAG,QAAQ;MAE3B,IAAI;QACF;QACA,MAAMG,GAAG,GAAG,MAAMf,KAAK,CAACgB,IAAI,CAAC,wBAAwB,EAAEf,IAAI,CAAC;QAE5D,IAAIc,GAAG,CAACE,IAAI,CAACC,IAAI,KAAK,IAAI,EAAE;UAC1B,MAAMC,MAAM,GAAGJ,GAAG,CAACE,IAAI,CAACG,OAAO;UAC/BrB,SAAS,CAACsB,OAAO,CAAC,gBAAgB,CAAC;UACnC;UACAC,YAAY,CAACH,MAAM,CAAC;QACtB,CAAC,MAAM;UACLpB,SAAS,CAACwB,KAAK,CAACR,GAAG,CAACE,IAAI,CAACO,GAAG,IAAI,MAAM,CAAC;UACvClB,YAAY,CAACM,KAAK,GAAG,KAAK;QAC5B;MACF,CAAC,CAAC,OAAOW,KAAK,EAAE;QACdE,OAAO,CAACF,KAAK,CAACA,KAAK,CAAC;QACpBxB,SAAS,CAACwB,KAAK,CAAC,QAAQ,CAAC;QACzBjB,YAAY,CAACM,KAAK,GAAG,KAAK;MAC5B;IACF,CAAC;;IAED;IACA,MAAMU,YAAY,GAAIH,MAAM,IAAK;MAC/BT,SAAS,GAAGgB,WAAW,CAAC,YAAY;QAClC,IAAI;UACF,MAAMX,GAAG,GAAG,MAAMf,KAAK,CAAC2B,GAAG,CAAC,wBAAwBR,MAAM,EAAE,CAAC;UAE7D,IAAIJ,GAAG,CAACE,IAAI,CAACC,IAAI,KAAK,IAAI,EAAE;YAC1B,MAAMD,IAAI,GAAGF,GAAG,CAACE,IAAI,CAACA,IAAI;YAC1BT,UAAU,CAACI,KAAK,GAAGK,IAAI,CAACW,MAAM,EAAC;;YAE/B,IAAIX,IAAI,CAACW,MAAM,KAAK,SAAS,EAAE;cAC7B;cACAC,aAAa,CAACnB,SAAS,CAAC;cACxBH,WAAW,CAACK,KAAK,GAAGK,IAAI,CAACa,SAAS;cAClCxB,YAAY,CAACM,KAAK,GAAG,KAAK;cAC1Bb,SAAS,CAACsB,OAAO,CAAC,SAAS,CAAC;YAC9B,CAAC,MAAM,IAAIJ,IAAI,CAACW,MAAM,KAAK,MAAM,EAAE;cACjC;cACAC,aAAa,CAACnB,SAAS,CAAC;cACxBJ,YAAY,CAACM,KAAK,GAAG,KAAK;cAC1BH,UAAU,CAACG,KAAK,GAAGK,IAAI,CAACc,UAAU;cAClChC,SAAS,CAACwB,KAAK,CAAC,UAAU,GAAGN,IAAI,CAACc,UAAU,CAAC;YAC/C;YACA;UACF,CAAC,MAAM;YACL;YACAF,aAAa,CAACnB,SAAS,CAAC;YACxBJ,YAAY,CAACM,KAAK,GAAG,KAAK;YAC1Bb,SAAS,CAACwB,KAAK,CAACR,GAAG,CAACE,IAAI,CAACO,GAAG,CAAC;UAC/B;QACF,CAAC,CAAC,OAAOD,KAAK,EAAE;UACd;UACAE,OAAO,CAACF,KAAK,CAAC,MAAM,EAAEA,KAAK,CAAC;QAC9B;MACF,CAAC,EAAE,IAAI,CAAC,EAAC;IACX,CAAC;;IAED;IACA,MAAMS,aAAa,GAAGA,CAAA,KAAM;MAC1B,IAAI,CAACzB,WAAW,CAACK,KAAK,EAAE;MACxBqB,MAAM,CAACC,IAAI,CAAC3B,WAAW,CAACK,KAAK,EAAE,QAAQ,CAAC;IAC1C,CAAC;;IAED;IACAlB,WAAW,CAAC,MAAM;MAChB,IAAIgB,SAAS,EAAEmB,aAAa,CAACnB,SAAS,CAAC;IACzC,CAAC,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}