{"ast":null,"code":"import { ref, reactive, onMounted, computed } from 'vue';\nimport { ArrowLeft, ChatDotRound, Heart, HeartFilled } from '@element-plus/icons-vue';\nimport { ElMessage, ElMessageBox } from 'element-plus';\nimport axios from 'axios';\n\n// 创建axios实例，自动指向api/v1前缀\n\nexport default {\n  __name: 'Suggestion',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const request = axios.create({\n      baseURL: '/api/v1',\n      // 接口前缀自动指向api/v1\n      timeout: 10000,\n      headers: {\n        'Content-Type': 'application/json;charset=UTF-8'\n      }\n    });\n\n    // 请求拦截器：添加登录凭证（从localStorage获取）\n    request.interceptors.request.use(config => {\n      const userInfo = JSON.parse(localStorage.getItem('userInfo') || '{\"userId\":\"\",\"username\":\"\"}');\n      if (userInfo.userId && userInfo.username) {\n        config.headers['X-User-ID'] = userInfo.userId;\n        config.headers['X-Username'] = userInfo.username;\n      }\n      return config;\n    }, error => Promise.reject(error));\n\n    // 响应拦截器：统一处理结果\n    request.interceptors.response.use(response => {\n      const res = response.data;\n      if (res.code !== 200) {\n        ElMessage.error(res.msg || '操作失败');\n        return Promise.reject(res);\n      }\n      return res;\n    }, error => {\n      ElMessage.error(error.message || '网络异常');\n      return Promise.reject(error);\n    });\n\n    // 当前登录用户\n    const currentUser = computed(() => {\n      return JSON.parse(localStorage.getItem('userInfo') || '{\"userId\":\"\",\"username\":\"\"}');\n    });\n\n    // 发布评论相关\n    const publishContent = ref('');\n    const isPublishing = ref(false);\n\n    // 根评论相关\n    const rootComments = ref([]);\n    const rootPageInfo = reactive({\n      page: 1,\n      page_size: 10,\n      total: 0\n    });\n\n    // 回复相关\n    const showReplyId = ref(0); // 显示哪个根评论的回复面板\n    const replyContent = ref('');\n    const isReplying = ref(false);\n    const replyToUserId = ref(''); // 被回复者ID\n    const replyToUsername = ref(''); // 被回复者昵称\n    const replyList = ref({}); // 存储各根评论的回复列表 {rootId: []}\n    const replyPageInfo = reactive({}); // 存储各根评论的回复分页信息 {rootId: {page, page_size, total}}\n\n    // 编辑评论相关\n    const updateDialogVisible = ref(false);\n    const updateContent = ref('');\n    const updateCommentId = ref(0);\n    const isUpdating = ref(false);\n\n    // 格式化时间\n    const formatTime = timeStr => {\n      if (!timeStr) return '';\n      const date = new Date(timeStr);\n      return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-${date.getDate().toString().padStart(2, '0')} ${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`;\n    };\n\n    // 获取根评论列表\n    const getRootComments = async () => {\n      try {\n        const res = await request.post('/suggestion/root/page', {\n          page: rootPageInfo.page,\n          page_size: rootPageInfo.page_size\n        });\n        rootComments.value = res.data.list || [];\n        rootPageInfo.total = res.data.total || 0;\n        // 初始化点赞状态（示例：实际需从接口/本地存储获取）\n        rootComments.value.forEach(item => {\n          item.isLiked = false;\n        });\n      } catch (err) {\n        console.error('获取根评论失败：', err);\n      }\n    };\n\n    // 获取指定根评论的回复列表\n    const getReplyList = async rootId => {\n      if (!replyPageInfo[rootId]) {\n        replyPageInfo[rootId] = {\n          page: 1,\n          page_size: 10,\n          total: 0\n        };\n      }\n      try {\n        const res = await request.post('/suggestion/reply/page', {\n          root_id: rootId,\n          page: replyPageInfo[rootId].page,\n          page_size: replyPageInfo[rootId].page_size\n        });\n        replyList.value[rootId] = res.data.list || [];\n        replyPageInfo[rootId].total = res.data.total || 0;\n        // 初始化点赞状态\n        replyList.value[rootId].forEach(item => {\n          item.isLiked = false;\n        });\n      } catch (err) {\n        console.error(`获取根评论${rootId}的回复失败：`, err);\n      }\n    };\n\n    // 发布根评论\n    const handlePublish = async () => {\n      if (!publishContent.value.trim()) {\n        return ElMessage.warning('评论内容不能为空');\n      }\n      if (publishContent.value.length > 500) {\n        return ElMessage.warning('评论内容不能超过500字');\n      }\n      if (!currentUser.value.userId) {\n        return ElMessage.warning('请先登录');\n      }\n      isPublishing.value = true;\n      try {\n        await request.post('/suggestion/publish', {\n          content: publishContent.value.trim()\n        });\n        ElMessage.success('评论发布成功');\n        publishContent.value = '';\n        // 重新加载根评论列表\n        getRootComments();\n      } catch (err) {\n        console.error('发布评论失败：', err);\n      } finally {\n        isPublishing.value = false;\n      }\n    };\n\n    // 点赞/取消点赞\n    const handleLike = async (id, isLike) => {\n      if (!currentUser.value.userId) {\n        return ElMessage.warning('请先登录');\n      }\n      try {\n        const res = await request.post('/suggestion/like', {\n          id,\n          is_like: isLike\n        });\n        // 更新点赞数和状态\n        // 先更新根评论\n        const rootIndex = rootComments.value.findIndex(item => item.id === id);\n        if (rootIndex > -1) {\n          rootComments.value[rootIndex].like_count = res.data.like_count;\n          rootComments.value[rootIndex].isLiked = isLike;\n        } else {\n          // 再更新回复\n          Object.keys(replyList.value).forEach(rootId => {\n            const replyIndex = replyList.value[rootId].findIndex(item => item.id === id);\n            if (replyIndex > -1) {\n              replyList.value[rootId][replyIndex].like_count = res.data.like_count;\n              replyList.value[rootId][replyIndex].isLiked = isLike;\n            }\n          });\n        }\n        ElMessage.success(isLike ? '点赞成功' : '取消点赞成功');\n      } catch (err) {\n        console.error('点赞操作失败：', err);\n      }\n    };\n\n    // 切换回复面板显示\n    const toggleReplyPanel = rootId => {\n      showReplyId.value = rootId;\n      if (rootId > 0) {\n        // 加载回复列表\n        getReplyList(rootId);\n        // 重置回复目标\n        replyToUserId.value = '';\n        replyToUsername.value = '';\n      }\n      replyContent.value = '';\n    };\n\n    // 回复指定用户\n    const replyToUser = (replyId, userId, username) => {\n      replyToUserId.value = userId;\n      replyToUsername.value = username;\n      replyContent.value = `@${username} `;\n      // 自动聚焦（需结合DOM操作，示例简化）\n    };\n\n    // 提交回复\n    const handleReply = async rootId => {\n      if (!replyContent.value.trim()) {\n        return ElMessage.warning('回复内容不能为空');\n      }\n      if (!currentUser.value.userId) {\n        return ElMessage.warning('请先登录');\n      }\n      isReplying.value = true;\n      try {\n        await request.post('/suggestion/reply', {\n          parent_id: rootId,\n          reply_to_user_id: replyToUserId.value,\n          reply_to_username: replyToUsername.value,\n          content: replyContent.value.trim()\n        });\n        ElMessage.success('回复成功');\n        replyContent.value = '';\n        // 重新加载回复列表\n        getReplyList(rootId);\n      } catch (err) {\n        console.error('回复失败：', err);\n      } finally {\n        isReplying.value = false;\n      }\n    };\n\n    // 显示编辑弹窗\n    const showUpdateDialog = (id, content) => {\n      updateCommentId.value = id;\n      updateContent.value = content;\n      updateDialogVisible.value = true;\n    };\n\n    // 确认更新评论\n    const handleUpdateConfirm = async () => {\n      if (!updateContent.value.trim()) {\n        return ElMessage.warning('评论内容不能为空');\n      }\n      if (!currentUser.value.userId) {\n        return ElMessage.warning('请先登录');\n      }\n      isUpdating.value = true;\n      try {\n        await request.post('/suggestion/update', {\n          id: updateCommentId.value,\n          content: updateContent.value.trim()\n        });\n        ElMessage.success('评论修改成功');\n        updateDialogVisible.value = false;\n        // 重新加载根评论列表\n        getRootComments();\n      } catch (err) {\n        console.error('更新评论失败：', err);\n      } finally {\n        isUpdating.value = false;\n      }\n    };\n\n    // 删除评论\n    const handleDelete = async id => {\n      try {\n        await ElMessageBox.confirm('确定要删除这条评论吗？删除后无法恢复', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        });\n        await request.post('/suggestion/delete', {\n          id\n        });\n        ElMessage.success('评论删除成功');\n        // 重新加载根评论列表\n        getRootComments();\n      } catch (err) {\n        if (err !== 'cancel') {\n          console.error('删除评论失败：', err);\n        }\n      }\n    };\n\n    // 根评论分页事件\n    const handleRootSizeChange = val => {\n      rootPageInfo.page_size = val;\n      getRootComments();\n    };\n    const handleRootPageChange = val => {\n      rootPageInfo.page = val;\n      getRootComments();\n    };\n\n    // 回复分页事件\n    const handleReplySizeChange = (rootId, val) => {\n      replyPageInfo[rootId].page_size = val;\n      getReplyList(rootId);\n    };\n    const handleReplyPageChange = (rootId, val) => {\n      replyPageInfo[rootId].page = val;\n      getReplyList(rootId);\n    };\n\n    // 获取指定根评论的回复列表（模板用）\n    const getReplyListTemplate = rootId => {\n      return replyList.value[rootId] || [];\n    };\n\n    // 页面加载时获取根评论\n    onMounted(() => {\n      getRootComments();\n    });\n    const __returned__ = {\n      request,\n      currentUser,\n      publishContent,\n      isPublishing,\n      rootComments,\n      rootPageInfo,\n      showReplyId,\n      replyContent,\n      isReplying,\n      replyToUserId,\n      replyToUsername,\n      replyList,\n      replyPageInfo,\n      updateDialogVisible,\n      updateContent,\n      updateCommentId,\n      isUpdating,\n      formatTime,\n      getRootComments,\n      getReplyList,\n      handlePublish,\n      handleLike,\n      toggleReplyPanel,\n      replyToUser,\n      handleReply,\n      showUpdateDialog,\n      handleUpdateConfirm,\n      handleDelete,\n      handleRootSizeChange,\n      handleRootPageChange,\n      handleReplySizeChange,\n      handleReplyPageChange,\n      getReplyListTemplate,\n      ref,\n      reactive,\n      onMounted,\n      computed,\n      get ArrowLeft() {\n        return ArrowLeft;\n      },\n      get ChatDotRound() {\n        return ChatDotRound;\n      },\n      get Heart() {\n        return Heart;\n      },\n      get HeartFilled() {\n        return HeartFilled;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get ElMessageBox() {\n        return ElMessageBox;\n      },\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","computed","ArrowLeft","ChatDotRound","Heart","HeartFilled","ElMessage","ElMessageBox","axios","request","create","baseURL","timeout","headers","interceptors","use","config","userInfo","JSON","parse","localStorage","getItem","userId","username","error","Promise","reject","response","res","data","code","msg","message","currentUser","publishContent","isPublishing","rootComments","rootPageInfo","page","page_size","total","showReplyId","replyContent","isReplying","replyToUserId","replyToUsername","replyList","replyPageInfo","updateDialogVisible","updateContent","updateCommentId","isUpdating","formatTime","timeStr","date","Date","getFullYear","getMonth","toString","padStart","getDate","getHours","getMinutes","getRootComments","post","value","list","forEach","item","isLiked","err","console","getReplyList","rootId","root_id","handlePublish","trim","warning","length","content","success","handleLike","id","isLike","is_like","rootIndex","findIndex","like_count","Object","keys","replyIndex","toggleReplyPanel","replyToUser","replyId","handleReply","parent_id","reply_to_user_id","reply_to_username","showUpdateDialog","handleUpdateConfirm","handleDelete","confirm","confirmButtonText","cancelButtonText","type","handleRootSizeChange","val","handleRootPageChange","handleReplySizeChange","handleReplyPageChange","getReplyListTemplate"],"sources":["C:/Users/11395/Desktop/design-graduation/gradulation/vue-frontend/src/views/Suggestion.vue"],"sourcesContent":["<template>\r\n  <div class=\"page-container comment-theme\">\r\n    <el-header class=\"header\">\r\n      <div class=\"left\">\r\n        <el-button link @click=\"$router.back()\" class=\"back-btn\">\r\n          <el-icon><ArrowLeft /></el-icon> 返回\r\n        </el-button>\r\n        <h2>评论互动区</h2>\r\n      </div>\r\n    </el-header>\r\n\r\n    <el-main class=\"main-content\">\r\n      <div class=\"comment-studio\">\r\n        <!-- 发布评论输入区 -->\r\n        <div class=\"input-section glass-card\">\r\n          <el-textarea\r\n            v-model=\"publishContent\"\r\n            placeholder=\"分享你的想法（1-500字）\"\r\n            class=\"comment-input\"\r\n            :maxlength=\"500\"\r\n            show-word-limit\r\n            rows=\"3\"\r\n            clearable\r\n          >\r\n            <template #prefix>\r\n              <el-icon><ChatDotRound /></el-icon>\r\n            </template>\r\n          </el-textarea>\r\n          <el-button \r\n            type=\"primary\" \r\n            size=\"large\" \r\n            @click=\"handlePublish\" \r\n            :loading=\"isPublishing\"\r\n            class=\"publish-btn\"\r\n          >\r\n            发布评论\r\n          </el-button>\r\n        </div>\r\n\r\n        <!-- 评论列表区域 -->\r\n        <div class=\"comment-list glass-card\">\r\n          <!-- 根评论列表 -->\r\n          <div v-if=\"rootComments.length > 0\" class=\"root-comments\">\r\n            <div \r\n              v-for=\"comment in rootComments\" \r\n              :key=\"comment.id\" \r\n              class=\"root-comment-item\"\r\n            >\r\n              <!-- 根评论内容 -->\r\n              <div class=\"comment-header\">\r\n                <span class=\"username\">{{ comment.username }}</span>\r\n                <span class=\"create-time\">{{ formatTime(comment.create_time) }}</span>\r\n              </div>\r\n              <div class=\"comment-content\">{{ comment.content }}</div>\r\n              \r\n              <!-- 评论操作区 -->\r\n              <div class=\"comment-actions\">\r\n                <el-button \r\n                  type=\"text\" \r\n                  @click=\"handleLike(comment.id, true)\"\r\n                  :icon=\"comment.isLiked ? HeartFilled : Heart\"\r\n                  class=\"like-btn\"\r\n                >\r\n                  点赞 ({{ comment.like_count }})\r\n                </el-button>\r\n                <el-button \r\n                  type=\"text\" \r\n                  @click=\"toggleReplyPanel(comment.id)\"\r\n                  class=\"reply-btn\"\r\n                >\r\n                  回复 ({{ comment.reply_count }})\r\n                </el-button>\r\n                <!-- 仅自己的评论显示编辑/删除 -->\r\n                <el-button \r\n                  v-if=\"comment.user_id === currentUser.userId\"\r\n                  type=\"text\" \r\n                  @click=\"showUpdateDialog(comment.id, comment.content)\"\r\n                  class=\"edit-btn\"\r\n                >\r\n                  编辑\r\n                </el-button>\r\n                <el-button \r\n                  v-if=\"comment.user_id === currentUser.userId\"\r\n                  type=\"text\" \r\n                  @click=\"handleDelete(comment.id)\"\r\n                  class=\"delete-btn\"\r\n                >\r\n                  删除\r\n                </el-button>\r\n              </div>\r\n\r\n              <!-- 回复输入面板 -->\r\n              <div v-if=\"showReplyId === comment.id\" class=\"reply-input-panel\">\r\n                <el-textarea\r\n                  v-model=\"replyContent\"\r\n                  placeholder=\"输入你的回复...\"\r\n                  :maxlength=\"500\"\r\n                  show-word-limit\r\n                  rows=\"2\"\r\n                  class=\"reply-input\"\r\n                ></el-textarea>\r\n                <div class=\"reply-actions\">\r\n                  <el-button \r\n                    type=\"primary\" \r\n                    size=\"small\" \r\n                    @click=\"handleReply(comment.id)\"\r\n                    :loading=\"isReplying\"\r\n                  >\r\n                    提交回复\r\n                  </el-button>\r\n                  <el-button \r\n                    size=\"small\" \r\n                    @click=\"toggleReplyPanel(0)\"\r\n                  >\r\n                    取消\r\n                  </el-button>\r\n                </div>\r\n              </div>\r\n\r\n              <!-- 回复列表 -->\r\n              <div v-if=\"showReplyId === comment.id\" class=\"reply-list\">\r\n                <div \r\n                  v-for=\"reply in getReplyList(comment.id)\" \r\n                  :key=\"reply.id\" \r\n                  class=\"reply-item\"\r\n                >\r\n                  <div class=\"reply-header\">\r\n                    <span class=\"reply-username\">{{ reply.username }}</span>\r\n                    <span v-if=\"reply.reply_to_username\" class=\"reply-to\">\r\n                      回复 @{{ reply.reply_to_username }}\r\n                    </span>\r\n                  </div>\r\n                  <div class=\"reply-content\">{{ reply.content }}</div>\r\n                  <div class=\"reply-actions\">\r\n                    <el-button \r\n                      type=\"text\" \r\n                      size=\"small\"\r\n                      @click=\"handleLike(reply.id, true)\"\r\n                      :icon=\"reply.isLiked ? HeartFilled : Heart\"\r\n                    >\r\n                      点赞 ({{ reply.like_count }})\r\n                    </el-button>\r\n                    <el-button \r\n                      type=\"text\" \r\n                      size=\"small\"\r\n                      @click=\"replyToUser(reply.id, reply.user_id, reply.username)\"\r\n                    >\r\n                      回复\r\n                    </el-button>\r\n                  </div>\r\n                </div>\r\n\r\n                <!-- 回复分页 -->\r\n                <el-pagination\r\n                  v-if=\"replyPageInfo[comment.id]?.total > 0\"\r\n                  @size-change=\"handleReplySizeChange(comment.id, $event)\"\r\n                  @current-change=\"handleReplyPageChange(comment.id, $event)\"\r\n                  :current-page=\"replyPageInfo[comment.id]?.page || 1\"\r\n                  :page-sizes=\"[5, 10, 20]\"\r\n                  :page-size=\"replyPageInfo[comment.id]?.page_size || 10\"\r\n                  layout=\"total, sizes, prev, pager, next, jumper\"\r\n                  :total=\"replyPageInfo[comment.id]?.total || 0\"\r\n                  small\r\n                  class=\"reply-pagination\"\r\n                >\r\n                </el-pagination>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- 空状态 -->\r\n          <div v-else class=\"empty-comment\">\r\n            <el-empty description=\"暂无评论，快来发表第一条评论吧～\" />\r\n          </div>\r\n\r\n          <!-- 根评论分页 -->\r\n          <el-pagination\r\n            v-if=\"rootPageInfo.total > 0\"\r\n            @size-change=\"handleRootSizeChange\"\r\n            @current-change=\"handleRootPageChange\"\r\n            :current-page=\"rootPageInfo.page\"\r\n            :page-sizes=\"[10, 20, 50]\"\r\n            :page-size=\"rootPageInfo.page_size\"\r\n            layout=\"total, sizes, prev, pager, next, jumper\"\r\n            :total=\"rootPageInfo.total\"\r\n            class=\"root-pagination\"\r\n          >\r\n          </el-pagination>\r\n        </div>\r\n      </div>\r\n    </el-main>\r\n\r\n    <!-- 编辑评论弹窗 -->\r\n    <el-dialog \r\n      v-model=\"updateDialogVisible\" \r\n      title=\"编辑评论\" \r\n      width=\"500px\"\r\n      class=\"update-dialog\"\r\n    >\r\n      <el-textarea\r\n        v-model=\"updateContent\"\r\n        placeholder=\"修改你的评论内容...\"\r\n        :maxlength=\"500\"\r\n        show-word-limit\r\n        rows=\"4\"\r\n      ></el-textarea>\r\n      <template #footer>\r\n        <el-button @click=\"updateDialogVisible = false\">取消</el-button>\r\n        <el-button \r\n          type=\"primary\" \r\n          @click=\"handleUpdateConfirm\"\r\n          :loading=\"isUpdating\"\r\n        >\r\n          确认修改\r\n        </el-button>\r\n      </template>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, reactive, onMounted, computed } from 'vue'\r\nimport { \r\n  ArrowLeft, ChatDotRound, Heart, HeartFilled \r\n} from '@element-plus/icons-vue'\r\nimport { ElMessage, ElMessageBox } from 'element-plus'\r\nimport axios from 'axios'\r\n\r\n// 创建axios实例，自动指向api/v1前缀\r\nconst request = axios.create({\r\n  baseURL: '/api/v1', // 接口前缀自动指向api/v1\r\n  timeout: 10000,\r\n  headers: {\r\n    'Content-Type': 'application/json;charset=UTF-8'\r\n  }\r\n})\r\n\r\n// 请求拦截器：添加登录凭证（从localStorage获取）\r\nrequest.interceptors.request.use(\r\n  config => {\r\n    const userInfo = JSON.parse(localStorage.getItem('userInfo') || '{\"userId\":\"\",\"username\":\"\"}')\r\n    if (userInfo.userId && userInfo.username) {\r\n      config.headers['X-User-ID'] = userInfo.userId\r\n      config.headers['X-Username'] = userInfo.username\r\n    }\r\n    return config\r\n  },\r\n  error => Promise.reject(error)\r\n)\r\n\r\n// 响应拦截器：统一处理结果\r\nrequest.interceptors.response.use(\r\n  response => {\r\n    const res = response.data\r\n    if (res.code !== 200) {\r\n      ElMessage.error(res.msg || '操作失败')\r\n      return Promise.reject(res)\r\n    }\r\n    return res\r\n  },\r\n  error => {\r\n    ElMessage.error(error.message || '网络异常')\r\n    return Promise.reject(error)\r\n  }\r\n)\r\n\r\n// 当前登录用户\r\nconst currentUser = computed(() => {\r\n  return JSON.parse(localStorage.getItem('userInfo') || '{\"userId\":\"\",\"username\":\"\"}')\r\n})\r\n\r\n// 发布评论相关\r\nconst publishContent = ref('')\r\nconst isPublishing = ref(false)\r\n\r\n// 根评论相关\r\nconst rootComments = ref([])\r\nconst rootPageInfo = reactive({\r\n  page: 1,\r\n  page_size: 10,\r\n  total: 0\r\n})\r\n\r\n// 回复相关\r\nconst showReplyId = ref(0) // 显示哪个根评论的回复面板\r\nconst replyContent = ref('')\r\nconst isReplying = ref(false)\r\nconst replyToUserId = ref('') // 被回复者ID\r\nconst replyToUsername = ref('') // 被回复者昵称\r\nconst replyList = ref({}) // 存储各根评论的回复列表 {rootId: []}\r\nconst replyPageInfo = reactive({}) // 存储各根评论的回复分页信息 {rootId: {page, page_size, total}}\r\n\r\n// 编辑评论相关\r\nconst updateDialogVisible = ref(false)\r\nconst updateContent = ref('')\r\nconst updateCommentId = ref(0)\r\nconst isUpdating = ref(false)\r\n\r\n// 格式化时间\r\nconst formatTime = (timeStr) => {\r\n  if (!timeStr) return ''\r\n  const date = new Date(timeStr)\r\n  return `${date.getFullYear()}-${(date.getMonth()+1).toString().padStart(2, '0')}-${date.getDate().toString().padStart(2, '0')} ${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`\r\n}\r\n\r\n// 获取根评论列表\r\nconst getRootComments = async () => {\r\n  try {\r\n    const res = await request.post('/suggestion/root/page', {\r\n      page: rootPageInfo.page,\r\n      page_size: rootPageInfo.page_size\r\n    })\r\n    rootComments.value = res.data.list || []\r\n    rootPageInfo.total = res.data.total || 0\r\n    // 初始化点赞状态（示例：实际需从接口/本地存储获取）\r\n    rootComments.value.forEach(item => {\r\n      item.isLiked = false\r\n    })\r\n  } catch (err) {\r\n    console.error('获取根评论失败：', err)\r\n  }\r\n}\r\n\r\n// 获取指定根评论的回复列表\r\nconst getReplyList = async (rootId) => {\r\n  if (!replyPageInfo[rootId]) {\r\n    replyPageInfo[rootId] = {\r\n      page: 1,\r\n      page_size: 10,\r\n      total: 0\r\n    }\r\n  }\r\n  try {\r\n    const res = await request.post('/suggestion/reply/page', {\r\n      root_id: rootId,\r\n      page: replyPageInfo[rootId].page,\r\n      page_size: replyPageInfo[rootId].page_size\r\n    })\r\n    replyList.value[rootId] = res.data.list || []\r\n    replyPageInfo[rootId].total = res.data.total || 0\r\n    // 初始化点赞状态\r\n    replyList.value[rootId].forEach(item => {\r\n      item.isLiked = false\r\n    })\r\n  } catch (err) {\r\n    console.error(`获取根评论${rootId}的回复失败：`, err)\r\n  }\r\n}\r\n\r\n// 发布根评论\r\nconst handlePublish = async () => {\r\n  if (!publishContent.value.trim()) {\r\n    return ElMessage.warning('评论内容不能为空')\r\n  }\r\n  if (publishContent.value.length > 500) {\r\n    return ElMessage.warning('评论内容不能超过500字')\r\n  }\r\n  if (!currentUser.value.userId) {\r\n    return ElMessage.warning('请先登录')\r\n  }\r\n\r\n  isPublishing.value = true\r\n  try {\r\n    await request.post('/suggestion/publish', {\r\n      content: publishContent.value.trim()\r\n    })\r\n    ElMessage.success('评论发布成功')\r\n    publishContent.value = ''\r\n    // 重新加载根评论列表\r\n    getRootComments()\r\n  } catch (err) {\r\n    console.error('发布评论失败：', err)\r\n  } finally {\r\n    isPublishing.value = false\r\n  }\r\n}\r\n\r\n// 点赞/取消点赞\r\nconst handleLike = async (id, isLike) => {\r\n  if (!currentUser.value.userId) {\r\n    return ElMessage.warning('请先登录')\r\n  }\r\n  try {\r\n    const res = await request.post('/suggestion/like', {\r\n      id,\r\n      is_like: isLike\r\n    })\r\n    // 更新点赞数和状态\r\n    // 先更新根评论\r\n    const rootIndex = rootComments.value.findIndex(item => item.id === id)\r\n    if (rootIndex > -1) {\r\n      rootComments.value[rootIndex].like_count = res.data.like_count\r\n      rootComments.value[rootIndex].isLiked = isLike\r\n    } else {\r\n      // 再更新回复\r\n      Object.keys(replyList.value).forEach(rootId => {\r\n        const replyIndex = replyList.value[rootId].findIndex(item => item.id === id)\r\n        if (replyIndex > -1) {\r\n          replyList.value[rootId][replyIndex].like_count = res.data.like_count\r\n          replyList.value[rootId][replyIndex].isLiked = isLike\r\n        }\r\n      })\r\n    }\r\n    ElMessage.success(isLike ? '点赞成功' : '取消点赞成功')\r\n  } catch (err) {\r\n    console.error('点赞操作失败：', err)\r\n  }\r\n}\r\n\r\n// 切换回复面板显示\r\nconst toggleReplyPanel = (rootId) => {\r\n  showReplyId.value = rootId\r\n  if (rootId > 0) {\r\n    // 加载回复列表\r\n    getReplyList(rootId)\r\n    // 重置回复目标\r\n    replyToUserId.value = ''\r\n    replyToUsername.value = ''\r\n  }\r\n  replyContent.value = ''\r\n}\r\n\r\n// 回复指定用户\r\nconst replyToUser = (replyId, userId, username) => {\r\n  replyToUserId.value = userId\r\n  replyToUsername.value = username\r\n  replyContent.value = `@${username} `\r\n  // 自动聚焦（需结合DOM操作，示例简化）\r\n}\r\n\r\n// 提交回复\r\nconst handleReply = async (rootId) => {\r\n  if (!replyContent.value.trim()) {\r\n    return ElMessage.warning('回复内容不能为空')\r\n  }\r\n  if (!currentUser.value.userId) {\r\n    return ElMessage.warning('请先登录')\r\n  }\r\n\r\n  isReplying.value = true\r\n  try {\r\n    await request.post('/suggestion/reply', {\r\n      parent_id: rootId,\r\n      reply_to_user_id: replyToUserId.value,\r\n      reply_to_username: replyToUsername.value,\r\n      content: replyContent.value.trim()\r\n    })\r\n    ElMessage.success('回复成功')\r\n    replyContent.value = ''\r\n    // 重新加载回复列表\r\n    getReplyList(rootId)\r\n  } catch (err) {\r\n    console.error('回复失败：', err)\r\n  } finally {\r\n    isReplying.value = false\r\n  }\r\n}\r\n\r\n// 显示编辑弹窗\r\nconst showUpdateDialog = (id, content) => {\r\n  updateCommentId.value = id\r\n  updateContent.value = content\r\n  updateDialogVisible.value = true\r\n}\r\n\r\n// 确认更新评论\r\nconst handleUpdateConfirm = async () => {\r\n  if (!updateContent.value.trim()) {\r\n    return ElMessage.warning('评论内容不能为空')\r\n  }\r\n  if (!currentUser.value.userId) {\r\n    return ElMessage.warning('请先登录')\r\n  }\r\n\r\n  isUpdating.value = true\r\n  try {\r\n    await request.post('/suggestion/update', {\r\n      id: updateCommentId.value,\r\n      content: updateContent.value.trim()\r\n    })\r\n    ElMessage.success('评论修改成功')\r\n    updateDialogVisible.value = false\r\n    // 重新加载根评论列表\r\n    getRootComments()\r\n  } catch (err) {\r\n    console.error('更新评论失败：', err)\r\n  } finally {\r\n    isUpdating.value = false\r\n  }\r\n}\r\n\r\n// 删除评论\r\nconst handleDelete = async (id) => {\r\n  try {\r\n    await ElMessageBox.confirm(\r\n      '确定要删除这条评论吗？删除后无法恢复',\r\n      '提示',\r\n      {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }\r\n    )\r\n    await request.post('/suggestion/delete', { id })\r\n    ElMessage.success('评论删除成功')\r\n    // 重新加载根评论列表\r\n    getRootComments()\r\n  } catch (err) {\r\n    if (err !== 'cancel') {\r\n      console.error('删除评论失败：', err)\r\n    }\r\n  }\r\n}\r\n\r\n// 根评论分页事件\r\nconst handleRootSizeChange = (val) => {\r\n  rootPageInfo.page_size = val\r\n  getRootComments()\r\n}\r\n\r\nconst handleRootPageChange = (val) => {\r\n  rootPageInfo.page = val\r\n  getRootComments()\r\n}\r\n\r\n// 回复分页事件\r\nconst handleReplySizeChange = (rootId, val) => {\r\n  replyPageInfo[rootId].page_size = val\r\n  getReplyList(rootId)\r\n}\r\n\r\nconst handleReplyPageChange = (rootId, val) => {\r\n  replyPageInfo[rootId].page = val\r\n  getReplyList(rootId)\r\n}\r\n\r\n// 获取指定根评论的回复列表（模板用）\r\nconst getReplyListTemplate = (rootId) => {\r\n  return replyList.value[rootId] || []\r\n}\r\n\r\n// 页面加载时获取根评论\r\nonMounted(() => {\r\n  getRootComments()\r\n})\r\n</script>\r\n\r\n<style scoped>\r\n.comment-theme {\r\n  background: linear-gradient(135deg, #2c3e50 0%, #000000 100%);\r\n}\r\n\r\n.page-container {\r\n  min-height: 100vh;\r\n  color: white;\r\n}\r\n\r\n.header {\r\n  background: rgba(255, 255, 255, 0.05);\r\n  backdrop-filter: blur(10px);\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 0 20px;\r\n}\r\n\r\n.left {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 20px;\r\n}\r\n\r\n.back-btn {\r\n  color: white !important;\r\n  font-size: 16px;\r\n}\r\n\r\n.main-content {\r\n  padding: 30px;\r\n  display: flex;\r\n  justify-content: center;\r\n}\r\n\r\n.comment-studio {\r\n  width: 100%;\r\n  max-width: 800px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 30px;\r\n}\r\n\r\n/* 玻璃拟态卡片 */\r\n.glass-card {\r\n  background: rgba(255, 255, 255, 0.08);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 20px;\r\n  padding: 30px;\r\n  border: 1px solid rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n/* 发布评论区域 */\r\n.input-section {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 20px;\r\n}\r\n\r\n:deep(.comment-input .el-textarea__wrapper) {\r\n  background: rgba(0,0,0,0.3);\r\n  border-radius: 15px;\r\n  box-shadow: none;\r\n  border: 1px solid #555;\r\n}\r\n\r\n:deep(.comment-input .el-textarea__inner) {\r\n  color: white;\r\n  font-size: 16px;\r\n  line-height: 1.5;\r\n}\r\n\r\n.publish-btn {\r\n  align-self: flex-end;\r\n  border-radius: 50px;\r\n  padding: 10px 30px;\r\n}\r\n\r\n/* 评论列表区域 */\r\n.comment-list {\r\n  min-height: 400px;\r\n}\r\n\r\n.root-comments {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 25px;\r\n}\r\n\r\n.root-comment-item {\r\n  padding-bottom: 20px;\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n.comment-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.username {\r\n  font-weight: 600;\r\n  color: #4facfe;\r\n}\r\n\r\n.create-time {\r\n  font-size: 12px;\r\n  color: #aeb6bf;\r\n}\r\n\r\n.comment-content {\r\n  line-height: 1.6;\r\n  margin-bottom: 15px;\r\n  font-size: 15px;\r\n}\r\n\r\n.comment-actions {\r\n  display: flex;\r\n  gap: 15px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n:deep(.comment-actions .el-button) {\r\n  color: #bdc3c7;\r\n}\r\n\r\n:deep(.like-btn .el-icon) {\r\n  color: #e74c3c;\r\n  margin-right: 5px;\r\n}\r\n\r\n/* 回复区域 */\r\n.reply-input-panel {\r\n  margin-top: 20px;\r\n  padding: 20px;\r\n  background: rgba(0,0,0,0.2);\r\n  border-radius: 15px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.reply-input {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n:deep(.reply-input .el-textarea__wrapper) {\r\n  background: rgba(0,0,0,0.3);\r\n  border-radius: 10px;\r\n}\r\n\r\n.reply-actions {\r\n  display: flex;\r\n  gap: 10px;\r\n  justify-content: flex-end;\r\n}\r\n\r\n.reply-list {\r\n  margin-top: 20px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 20px;\r\n  padding-left: 20px;\r\n  border-left: 2px solid rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n.reply-item {\r\n  padding: 15px;\r\n  background: rgba(0,0,0,0.15);\r\n  border-radius: 10px;\r\n}\r\n\r\n.reply-header {\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.reply-username {\r\n  font-weight: 500;\r\n  color: #00f2fe;\r\n}\r\n\r\n.reply-to {\r\n  font-size: 12px;\r\n  color: #aeb6bf;\r\n  margin-left: 8px;\r\n}\r\n\r\n.reply-content {\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n/* 分页样式 */\r\n.root-pagination {\r\n  margin-top: 30px;\r\n  text-align: center;\r\n}\r\n\r\n.reply-pagination {\r\n  margin-top: 15px;\r\n  text-align: right;\r\n}\r\n\r\n:deep(.el-pagination) {\r\n  --el-pagination-text-color: white;\r\n}\r\n\r\n:deep(.el-pagination button) {\r\n  color: white !important;\r\n}\r\n\r\n/* 空状态 */\r\n.empty-comment {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  min-height: 200px;\r\n}\r\n\r\n/* 编辑弹窗 */\r\n:deep(.update-dialog .el-dialog) {\r\n  background: rgba(0,0,0,0.8);\r\n  backdrop-filter: blur(10px);\r\n  border: 1px solid rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n:deep(.update-dialog .el-dialog__header) {\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n:deep(.update-dialog .el-dialog__title) {\r\n  color: white;\r\n}\r\n\r\n:deep(.update-dialog .el-textarea__wrapper) {\r\n  background: rgba(0,0,0,0.3);\r\n  color: white;\r\n}\r\n</style>"],"mappings":"AA6NA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,QAAQ,QAAQ,KAAK;AACxD,SACEC,SAAS,EAAEC,YAAY,EAAEC,KAAK,EAAEC,WAAW,QA