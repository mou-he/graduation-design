{"ast":null,"code":"import { ref, reactive, onMounted, onUnmounted, computed, nextTick } from 'vue';\nimport { useRouter, useRoute } from 'vue-router';\nimport { ArrowLeft } from '@element-plus/icons-vue'; // 删除点赞图标导入\nimport { ElMessage, ElMessageBox } from 'element-plus';\nimport axios from 'axios';\n\n// 初始化路由\n\nexport default {\n  __name: 'CommentSuggestion',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter();\n    const route = useRoute();\n\n    // 取消请求令牌（用于组件卸载时取消pending请求）\n    const cancelSources = ref([]);\n\n    // 创建axios实例\n    const createRequest = () => {\n      const request = axios.create({\n        baseURL: '/api',\n        timeout: 10000,\n        headers: {\n          'Content-Type': 'application/json;charset=UTF-8'\n        }\n      });\n\n      // 请求拦截器：添加登录凭证 + 取消令牌\n      request.interceptors.request.use(config => {\n        // 创建取消令牌\n        const source = axios.CancelToken.source();\n        config.cancelToken = source.token;\n        cancelSources.value.push(source);\n\n        // 添加用户信息\n        const userInfo = JSON.parse(localStorage.getItem('userInfo') || '{\"userId\":\"\",\"username\":\"\"}');\n        if (userInfo.userId && userInfo.username) {\n          config.headers['X-User-ID'] = userInfo.userId;\n          config.headers['X-Username'] = userInfo.username;\n          config.headers['Authorization'] = 'Bearer ' + localStorage.getItem('token');\n        }\n        return config;\n      }, error => Promise.reject(error));\n\n      // 响应拦截器：统一处理结果 - 适配后端返回格式\n      request.interceptors.response.use(response => {\n        const res = response.data;\n        // 1. 适配后端的成功状态码 1000\n        if (res.status_code !== 1000) {\n          // 2. 适配后端的提示字段 status_msg\n          ElMessage.error(res.status_msg || '操作失败');\n          return Promise.reject(res);\n        }\n        return res;\n      }, error => {\n        // 忽略取消请求的错误\n        if (axios.isCancel(error)) return Promise.reject(error);\n        ElMessage.error(error.message || '网络异常，请稍后重试');\n        return Promise.reject(error);\n      });\n      return request;\n    };\n    const request = createRequest();\n\n    // 当前登录用户\n    const currentUser = ref(JSON.parse(localStorage.getItem('userInfo') || '{\"userId\":\"\",\"username\":\"\"}'));\n    const isLogin = computed(() => !!currentUser.value.username); // 调整判断条件，用username更贴合返回数据\n\n    // 监听localStorage变化，同步用户状态\n    const handleStorageChange = () => {\n      currentUser.value = JSON.parse(localStorage.getItem('userInfo') || '{\"userId\":\"\",\"username\":\"\"}');\n    };\n\n    // 发布评论相关\n    const publishContent = ref('');\n    const isPublishing = ref(false);\n\n    // 根评论相关\n    const rootComments = ref([]);\n    const rootPageInfo = reactive({\n      page: 1,\n      page_size: 10,\n      total: 0\n    });\n\n    // 回复相关\n    const showReplyId = ref(0);\n    const replyContent = ref('');\n    const isReplying = ref(false);\n    const replyToUserId = ref('');\n    const replyToUsername = ref('');\n    const replyList = ref({});\n    const replyPageInfo = reactive({});\n\n    // 编辑评论相关\n    const updateDialogVisible = ref(false);\n    const updateContent = ref('');\n    const updateCommentId = ref(0);\n    const isUpdating = ref(false);\n\n    // 格式化时间 - 适配后端的时间格式（2026-03-02T11:05:12+08:00）\n    const formatTime = timeStr => {\n      if (!timeStr) return '';\n      try {\n        // 处理带时区的时间字符串\n        const date = new Date(timeStr);\n        const year = date.getFullYear();\n        const month = ('0' + (date.getMonth() + 1)).slice(-2);\n        const day = ('0' + date.getDate()).slice(-2);\n        const hour = ('0' + date.getHours()).slice(-2);\n        const minute = ('0' + date.getMinutes()).slice(-2);\n        return `${year}-${month}-${day} ${hour}:${minute}`;\n      } catch (e) {\n        return '未知时间';\n      }\n    };\n\n    // 获取根评论列表 - 适配后端返回格式（删除点赞相关初始化）\n    const getRootComments = async () => {\n      try {\n        const res = await request.post('/suggestion/root/page', {\n          page: rootPageInfo.page,\n          page_size: rootPageInfo.page_size\n        });\n        // 3. 适配后端数据结构：直接取 res.list 而非 res.data.list\n        rootComments.value = res.list || [];\n        rootPageInfo.total = res.total || 0;\n        // 移除点赞状态初始化\n      } catch (err) {\n        if (!axios.isCancel(err)) {\n          console.error('获取根评论失败：', err);\n        }\n      }\n    };\n\n    // 获取指定根评论的回复列表 - 适配后端返回格式（删除点赞相关初始化）\n    const getReplyList = async rootId => {\n      // 初始化分页信息\n      if (!replyPageInfo[rootId]) {\n        replyPageInfo[rootId] = {\n          page: 1,\n          page_size: 10,\n          total: 0\n        };\n      }\n      try {\n        const res = await request.post('/suggestion/reply/page', {\n          root_id: rootId,\n          page: replyPageInfo[rootId].page,\n          page_size: replyPageInfo[rootId].page_size\n        });\n        // 适配后端数据结构\n        replyList.value[rootId] = res.list || [];\n        replyPageInfo[rootId].total = res.total || 0;\n        // 移除点赞状态初始化\n      } catch (err) {\n        if (!axios.isCancel(err)) {\n          console.error(`获取根评论${rootId}的回复失败：`, err);\n        }\n      }\n    };\n\n    // 发布根评论\n    const handlePublish = async () => {\n      if (!publishContent.value.trim()) {\n        return ElMessage.warning('评论内容不能为空');\n      }\n      if (!isLogin.value) {\n        return ElMessage.warning('请先登录');\n      }\n      isPublishing.value = true;\n      try {\n        await request.post('/suggestion/publish', {\n          content: publishContent.value.trim()\n        });\n        ElMessage.success('评论发布成功');\n        publishContent.value = '';\n        // 发布成功后回到第一页并滚动到顶部\n        rootPageInfo.page = 1;\n        await getRootComments();\n        window.scrollTo({\n          top: 0,\n          behavior: 'smooth'\n        });\n      } catch (err) {\n        if (!axios.isCancel(err)) {\n          console.error('发布评论失败：', err);\n        }\n      } finally {\n        isPublishing.value = false;\n      }\n    };\n\n    // 切换回复面板显示\n    const toggleReplyPanel = rootId => {\n      showReplyId.value = rootId;\n      if (rootId > 0) {\n        // 重置分页数据\n        if (replyPageInfo[rootId]) {\n          replyPageInfo[rootId].page = 1;\n        }\n        getReplyList(rootId);\n        replyToUserId.value = '';\n        replyToUsername.value = '';\n      }\n      replyContent.value = '';\n    };\n\n    // 回复指定用户\n    const replyToUser = (replyId, userId, username) => {\n      replyToUserId.value = userId;\n      replyToUsername.value = username;\n      replyContent.value = `@${username} `;\n      // 聚焦回复输入框\n      nextTick(() => {\n        const replyInput = document.querySelector('.reply-input .el-textarea__inner');\n        if (replyInput) replyInput.focus();\n      });\n    };\n\n    // 提交回复（新增：回复成功后重新拉取根评论，刷新回复数）\n    const handleReply = async rootId => {\n      if (!replyContent.value.trim()) {\n        return ElMessage.warning('回复内容不能为空');\n      }\n      if (!isLogin.value) {\n        return ElMessage.warning('请先登录');\n      }\n      isReplying.value = true;\n      try {\n        await request.post('/suggestion/reply', {\n          parent_id: rootId,\n          reply_to_user_id: replyToUserId.value,\n          reply_to_username: replyToUsername.value,\n          content: replyContent.value.trim()\n        });\n        ElMessage.success('回复成功');\n        replyContent.value = '';\n        // 回复成功后重置分页并重新获取回复列表\n        replyPageInfo[rootId].page = 1;\n        await getReplyList(rootId);\n        // 重新拉取根评论，刷新回复数\n        await getRootComments();\n        // 滚动到回复列表底部\n        nextTick(() => {\n          const replyList = document.querySelector(`.reply-list`);\n          if (replyList) {\n            replyList.scrollTop = replyList.scrollHeight;\n          }\n        });\n      } catch (err) {\n        if (!axios.isCancel(err)) {\n          console.error('回复失败：', err);\n        }\n      } finally {\n        isReplying.value = false;\n      }\n    };\n\n    // 显示编辑弹窗\n    const showUpdateDialog = (id, content) => {\n      updateCommentId.value = id;\n      updateContent.value = content;\n      updateDialogVisible.value = true;\n    };\n\n    // 确认更新评论\n    const handleUpdateConfirm = async () => {\n      if (!updateContent.value.trim()) {\n        return ElMessage.warning('评论内容不能为空');\n      }\n      if (!isLogin.value) {\n        return ElMessage.warning('请先登录');\n      }\n      isUpdating.value = true;\n      try {\n        await request.post('/suggestion/update', {\n          id: updateCommentId.value,\n          content: updateContent.value.trim()\n        });\n        ElMessage.success('评论修改成功');\n        updateDialogVisible.value = false;\n        await getRootComments();\n      } catch (err) {\n        if (!axios.isCancel(err)) {\n          console.error('更新评论失败：', err);\n        }\n      } finally {\n        isUpdating.value = false;\n      }\n    };\n\n    // 删除评论\n    const handleDelete = async id => {\n      try {\n        await ElMessageBox.confirm('确定要删除这条评论吗？删除后无法恢复', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        });\n        await request.post('/suggestion/delete', {\n          id\n        });\n        ElMessage.success('评论删除成功');\n        await getRootComments();\n      } catch (err) {\n        if (err !== 'cancel' && !axios.isCancel(err)) {\n          console.error('删除评论失败：', err);\n        }\n      }\n    };\n\n    // 根评论分页事件\n    const handleRootSizeChange = val => {\n      rootPageInfo.page_size = val;\n      getRootComments();\n    };\n    const handleRootPageChange = val => {\n      rootPageInfo.page = val;\n      getRootComments();\n    };\n\n    // 回复分页事件\n    const handleReplySizeChange = (rootId, val) => {\n      replyPageInfo[rootId].page_size = val;\n      getReplyList(rootId);\n    };\n    const handleReplyPageChange = (rootId, val) => {\n      replyPageInfo[rootId].page = val;\n      getReplyList(rootId);\n    };\n\n    // 跳转到登录页\n    const toLogin = () => {\n      router.push({\n        path: '/login',\n        query: {\n          redirect: route.fullPath\n        }\n      });\n    };\n\n    // 组件生命周期\n    onMounted(() => {\n      // 监听localStorage变化\n      window.addEventListener('storage', handleStorageChange);\n      // 初始化获取评论\n      if (isLogin.value) {\n        getRootComments();\n      }\n    });\n    onUnmounted(() => {\n      // 移除监听\n      window.removeEventListener('storage', handleStorageChange);\n      // 取消所有pending请求\n      cancelSources.value.forEach(source => source.cancel('组件已卸载'));\n      cancelSources.value = [];\n    });\n    const __returned__ = {\n      router,\n      route,\n      cancelSources,\n      createRequest,\n      request,\n      currentUser,\n      isLogin,\n      handleStorageChange,\n      publishContent,\n      isPublishing,\n      rootComments,\n      rootPageInfo,\n      showReplyId,\n      replyContent,\n      isReplying,\n      replyToUserId,\n      replyToUsername,\n      replyList,\n      replyPageInfo,\n      updateDialogVisible,\n      updateContent,\n      updateCommentId,\n      isUpdating,\n      formatTime,\n      getRootComments,\n      getReplyList,\n      handlePublish,\n      toggleReplyPanel,\n      replyToUser,\n      handleReply,\n      showUpdateDialog,\n      handleUpdateConfirm,\n      handleDelete,\n      handleRootSizeChange,\n      handleRootPageChange,\n      handleReplySizeChange,\n      handleReplyPageChange,\n      toLogin,\n      ref,\n      reactive,\n      onMounted,\n      onUnmounted,\n      computed,\n      nextTick,\n      get useRouter() {\n        return useRouter;\n      },\n      get useRoute() {\n        return useRoute;\n      },\n      get ArrowLeft() {\n        return ArrowLeft;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get ElMessageBox() {\n        return ElMessageBox;\n      },\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","onUnmounted","computed","nextTick","useRouter","useRoute","ArrowLeft","ElMessage","ElMessageBox","axios","router","route","cancelSources","createRequest","request","create","baseURL","timeout","headers","interceptors","use","config","source","CancelToken","cancelToken","token","value","push","userInfo","JSON","parse","localStorage","getItem","userId","username","error","Promise","reject","response","res","data","status_code","status_msg","isCancel","message","currentUser","isLogin","handleStorageChange","publishContent","isPublishing","rootComments","rootPageInfo","page","page_size","total","showReplyId","replyContent","isReplying","replyToUserId","replyToUsername","replyList","replyPageInfo","updateDialogVisible","updateContent","updateCommentId","isUpdating","formatTime","timeStr","date","Date","year","getFullYear","month","getMonth","slice","day","getDate","hour","getHours","minute","getMinutes","e","getRootComments","post","list","err","console","getReplyList","rootId","root_id","handlePublish","trim","warning","content","success","window","scrollTo","top","behavior","toggleReplyPanel","replyToUser","replyId","replyInput","document","querySelector","focus","handleReply","parent_id","reply_to_user_id","reply_to_username","scrollTop","scrollHeight","showUpdateDialog","id","handleUpdateConfirm","handleDelete","confirm","confirmButtonText","cancelButtonText","type","handleRootSizeChange","val","handleRootPageChange","handleReplySizeChange","handleReplyPageChange","toLogin","path","query","redirect","fullPath","addEventListener","removeEventListener","forEach","cancel"],"sources":["C:/Users/11395/Desktop/design-graduation/gradulation/vue-frontend/src/views/CommentSuggestion.vue"],"sourcesContent":["<template>\r\n  <div class=\"page-container comment-theme\">\r\n    <!-- 未登录提示 -->\r\n    <div v-if=\"!isLogin\" class=\"login-tip glass-card\">\r\n      <el-empty description=\"请先登录后发表评论\" />\r\n      <el-button type=\"primary\" @click=\"toLogin\">去登录</el-button>\r\n    </div>\r\n\r\n    <!-- 已登录状态：头部和主要内容放在同一个 v-else 块中 -->\r\n    <template v-else>\r\n      <el-header class=\"header\">\r\n        <div class=\"left\">\r\n          <el-button link @click=\"router.back()\" class=\"back-btn\">\r\n            <el-icon><ArrowLeft /></el-icon> 返回\r\n          </el-button>\r\n          <h2>评论互动区</h2>\r\n        </div>\r\n      </el-header>\r\n\r\n      <el-main class=\"main-content\">\r\n        <div class=\"comment-studio\">\r\n          <!-- 发布评论输入区 -->\r\n          <div class=\"input-section glass-card\">\r\n            <el-input\r\n              v-model=\"publishContent\"\r\n              placeholder=\"分享你的想法（1-500字）\"\r\n              class=\"comment-input\"\r\n              :maxlength=\"500\"\r\n              show-word-limit\r\n              type=\"textarea\"\r\n              rows=\"3\"\r\n              clearable\r\n            />\r\n            <el-button\r\n              type=\"primary\"\r\n              size=\"large\"\r\n              @click=\"handlePublish\"\r\n              :loading=\"isPublishing\"\r\n              class=\"publish-btn\"\r\n            >\r\n              发布评论\r\n            </el-button>\r\n          </div>\r\n\r\n          <!-- 评论列表区域 -->\r\n          <div class=\"comment-list glass-card\">\r\n            <!-- 根评论列表 -->\r\n            <div v-if=\"rootComments.length > 0\" class=\"root-comments\">\r\n              <div\r\n                v-for=\"comment in rootComments\"\r\n                :key=\"comment.id\"\r\n                class=\"root-comment-item\"\r\n              >\r\n                <!-- 根评论内容 -->\r\n                <div class=\"comment-header\">\r\n                  <span class=\"username\">{{ comment.username }}</span>\r\n                  <span class=\"create-time\">{{ formatTime(comment.create_time) }}</span>\r\n                </div>\r\n                <div class=\"comment-content\">{{ comment.content }}</div>\r\n\r\n                <!-- 评论操作区（删除点赞按钮，只保留回复/编辑/删除） -->\r\n                <div class=\"comment-actions\">\r\n                  <el-button\r\n                    type=\"text\"\r\n                    @click=\"toggleReplyPanel(comment.id)\"\r\n                    class=\"reply-btn\"\r\n                  >\r\n                    回复 ({{ comment.reply_count }})\r\n                  </el-button>\r\n                  <!-- 仅自己的评论显示编辑/删除 -->\r\n                  <el-button\r\n                    v-if=\"comment.username === currentUser.username\"\r\n                    type=\"text\"\r\n                    @click=\"showUpdateDialog(comment.id, comment.content)\"\r\n                    class=\"edit-btn\"\r\n                  >\r\n                    编辑\r\n                  </el-button>\r\n                  <el-button\r\n                    v-if=\"comment.username === currentUser.username\"\r\n                    type=\"text\"\r\n                    @click=\"handleDelete(comment.id)\"\r\n                    class=\"delete-btn\"\r\n                  >\r\n                    删除\r\n                  </el-button>\r\n                </div>\r\n\r\n                <!-- 回复输入面板 -->\r\n                <div v-if=\"showReplyId === comment.id\" class=\"reply-input-panel\">\r\n                  <el-input\r\n                    v-model=\"replyContent\"\r\n                    placeholder=\"输入你的回复...\"\r\n                    :maxlength=\"500\"\r\n                    show-word-limit\r\n                    type=\"textarea\"\r\n                    rows=\"2\"\r\n                    class=\"reply-input\"\r\n                  />\r\n                  <div class=\"reply-actions\">\r\n                    <el-button\r\n                      type=\"primary\"\r\n                      size=\"small\"\r\n                      @click=\"handleReply(comment.id)\"\r\n                      :loading=\"isReplying\"\r\n                    >\r\n                      提交回复\r\n                    </el-button>\r\n                    <el-button size=\"small\" @click=\"toggleReplyPanel(0)\">\r\n                      取消\r\n                    </el-button>\r\n                  </div>\r\n                </div>\r\n\r\n                <!-- 回复列表（删除回复的点赞按钮） -->\r\n                <div v-if=\"showReplyId === comment.id\" class=\"reply-list\">\r\n                  <div\r\n                    v-for=\"reply in replyList[comment.id] || []\"\r\n                    :key=\"reply.id\"\r\n                    class=\"reply-item\"\r\n                  >\r\n                    <div class=\"reply-header\">\r\n                      <span class=\"reply-username\">{{ reply.username }}</span>\r\n                      <span v-if=\"reply.reply_to_username\" class=\"reply-to\">\r\n                        回复 @{{ reply.reply_to_username }}\r\n                      </span>\r\n                    </div>\r\n                    <div class=\"reply-content\">{{ reply.content }}</div>\r\n                    <div class=\"reply-actions\">\r\n                      <el-button\r\n                        type=\"text\"\r\n                        size=\"small\"\r\n                        @click=\"replyToUser(reply.id, reply.user_id, reply.username)\"\r\n                      >\r\n                        回复\r\n                      </el-button>\r\n                    </div>\r\n                  </div>\r\n\r\n                  <!-- 回复分页 -->\r\n                  <el-pagination\r\n                    v-if=\"replyPageInfo[comment.id] && replyPageInfo[comment.id].total > 0\"\r\n                    @size-change=\"handleReplySizeChange(comment.id, $event)\"\r\n                    @current-change=\"handleReplyPageChange(comment.id, $event)\"\r\n                    :current-page=\"(replyPageInfo[comment.id] && replyPageInfo[comment.id].page) || 1\"\r\n                    :page-sizes=\"[5, 10, 20]\"\r\n                    :page-size=\"(replyPageInfo[comment.id] && replyPageInfo[comment.id].page_size) || 10\"\r\n                    layout=\"total, sizes, prev, pager, next, jumper\"\r\n                    :total=\"(replyPageInfo[comment.id] && replyPageInfo[comment.id].total) || 0\"\r\n                    small\r\n                    class=\"reply-pagination\"\r\n                  />\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- 空状态 -->\r\n            <div v-else class=\"empty-comment\">\r\n              <el-empty description=\"暂无评论，快来发表第一条评论吧～\" />\r\n            </div>\r\n\r\n            <!-- 根评论分页 -->\r\n            <el-pagination\r\n              v-if=\"rootPageInfo.total > 0\"\r\n              @size-change=\"handleRootSizeChange\"\r\n              @current-change=\"handleRootPageChange\"\r\n              :current-page=\"rootPageInfo.page\"\r\n              :page-sizes=\"[10, 20, 50]\"\r\n              :page-size=\"rootPageInfo.page_size\"\r\n              layout=\"total, sizes, prev, pager, next, jumper\"\r\n              :total=\"rootPageInfo.total\"\r\n              class=\"root-pagination\"\r\n            />\r\n          </div>\r\n        </div>\r\n      </el-main>\r\n    </template>\r\n\r\n    <!-- 编辑评论弹窗 -->\r\n    <el-dialog\r\n      v-model=\"updateDialogVisible\"\r\n      title=\"编辑评论\"\r\n      width=\"500px\"\r\n      class=\"update-dialog\"\r\n    >\r\n      <el-input\r\n        v-model=\"updateContent\"\r\n        placeholder=\"修改你的评论内容...\"\r\n        :maxlength=\"500\"\r\n        show-word-limit\r\n        type=\"textarea\"\r\n        rows=\"4\"\r\n      />\r\n      <template #footer>\r\n        <el-button @click=\"updateDialogVisible = false\">取消</el-button>\r\n        <el-button\r\n          type=\"primary\"\r\n          @click=\"handleUpdateConfirm\"\r\n          :loading=\"isUpdating\"\r\n        >\r\n          确认修改\r\n        </el-button>\r\n      </template>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, reactive, onMounted, onUnmounted, computed, nextTick } from 'vue'\r\nimport { useRouter, useRoute } from 'vue-router'\r\nimport { ArrowLeft } from '@element-plus/icons-vue' // 删除点赞图标导入\r\nimport { ElMessage, ElMessageBox } from 'element-plus'\r\nimport axios from 'axios'\r\n\r\n// 初始化路由\r\nconst router = useRouter()\r\nconst route = useRoute()\r\n\r\n// 取消请求令牌（用于组件卸载时取消pending请求）\r\nconst cancelSources = ref([])\r\n\r\n// 创建axios实例\r\nconst createRequest = () => {\r\n  const request = axios.create({\r\n    baseURL: '/api',\r\n    timeout: 10000,\r\n    headers: {\r\n      'Content-Type': 'application/json;charset=UTF-8'\r\n    }\r\n  })\r\n\r\n  // 请求拦截器：添加登录凭证 + 取消令牌\r\n  request.interceptors.request.use(\r\n    config => {\r\n      // 创建取消令牌\r\n      const source = axios.CancelToken.source()\r\n      config.cancelToken = source.token\r\n      cancelSources.value.push(source)\r\n\r\n      // 添加用户信息\r\n      const userInfo = JSON.parse(localStorage.getItem('userInfo') || '{\"userId\":\"\",\"username\":\"\"}')\r\n      if (userInfo.userId && userInfo.username) {\r\n        config.headers['X-User-ID'] = userInfo.userId\r\n        config.headers['X-Username'] = userInfo.username\r\n        config.headers['Authorization'] = 'Bearer ' + localStorage.getItem('token')\r\n      }\r\n      return config\r\n    },\r\n    error => Promise.reject(error)\r\n  )\r\n\r\n  // 响应拦截器：统一处理结果 - 适配后端返回格式\r\n  request.interceptors.response.use(\r\n    response => {\r\n      const res = response.data\r\n      // 1. 适配后端的成功状态码 1000\r\n      if (res.status_code !== 1000) {\r\n        // 2. 适配后端的提示字段 status_msg\r\n        ElMessage.error(res.status_msg || '操作失败')\r\n        return Promise.reject(res)\r\n      }\r\n      return res\r\n    },\r\n    error => {\r\n      // 忽略取消请求的错误\r\n      if (axios.isCancel(error)) return Promise.reject(error)\r\n      ElMessage.error(error.message || '网络异常，请稍后重试')\r\n      return Promise.reject(error)\r\n    }\r\n  )\r\n\r\n  return request\r\n}\r\n\r\nconst request = createRequest()\r\n\r\n// 当前登录用户\r\nconst currentUser = ref(JSON.parse(localStorage.getItem('userInfo') || '{\"userId\":\"\",\"username\":\"\"}'))\r\nconst isLogin = computed(() => !!currentUser.value.username) // 调整判断条件，用username更贴合返回数据\r\n\r\n// 监听localStorage变化，同步用户状态\r\nconst handleStorageChange = () => {\r\n  currentUser.value = JSON.parse(localStorage.getItem('userInfo') || '{\"userId\":\"\",\"username\":\"\"}')\r\n}\r\n\r\n// 发布评论相关\r\nconst publishContent = ref('')\r\nconst isPublishing = ref(false)\r\n\r\n// 根评论相关\r\nconst rootComments = ref([])\r\nconst rootPageInfo = reactive({\r\n  page: 1,\r\n  page_size: 10,\r\n  total: 0\r\n})\r\n\r\n// 回复相关\r\nconst showReplyId = ref(0)\r\nconst replyContent = ref('')\r\nconst isReplying = ref(false)\r\nconst replyToUserId = ref('')\r\nconst replyToUsername = ref('')\r\nconst replyList = ref({})\r\nconst replyPageInfo = reactive({})\r\n\r\n// 编辑评论相关\r\nconst updateDialogVisible = ref(false)\r\nconst updateContent = ref('')\r\nconst updateCommentId = ref(0)\r\nconst isUpdating = ref(false)\r\n\r\n// 格式化时间 - 适配后端的时间格式（2026-03-02T11:05:12+08:00）\r\nconst formatTime = (timeStr) => {\r\n  if (!timeStr) return ''\r\n  try {\r\n    // 处理带时区的时间字符串\r\n    const date = new Date(timeStr)\r\n    const year = date.getFullYear()\r\n    const month = ('0' + (date.getMonth() + 1)).slice(-2)\r\n    const day = ('0' + date.getDate()).slice(-2)\r\n    const hour = ('0' + date.getHours()).slice(-2)\r\n    const minute = ('0' + date.getMinutes()).slice(-2)\r\n    return `${year}-${month}-${day} ${hour}:${minute}`\r\n  } catch (e) {\r\n    return '未知时间'\r\n  }\r\n}\r\n\r\n// 获取根评论列表 - 适配后端返回格式（删除点赞相关初始化）\r\nconst getRootComments = async () => {\r\n  try {\r\n    const res = await request.post('/suggestion/root/page', {\r\n      page: rootPageInfo.page,\r\n      page_size: rootPageInfo.page_size\r\n    })\r\n    // 3. 适配后端数据结构：直接取 res.list 而非 res.data.list\r\n    rootComments.value = res.list || []\r\n    rootPageInfo.total = res.total || 0\r\n    // 移除点赞状态初始化\r\n  } catch (err) {\r\n    if (!axios.isCancel(err)) {\r\n      console.error('获取根评论失败：', err)\r\n    }\r\n  }\r\n}\r\n\r\n// 获取指定根评论的回复列表 - 适配后端返回格式（删除点赞相关初始化）\r\nconst getReplyList = async (rootId) => {\r\n  // 初始化分页信息\r\n  if (!replyPageInfo[rootId]) {\r\n    replyPageInfo[rootId] = {\r\n      page: 1,\r\n      page_size: 10,\r\n      total: 0\r\n    }\r\n  }\r\n  try {\r\n    const res = await request.post('/suggestion/reply/page', {\r\n      root_id: rootId,\r\n      page: replyPageInfo[rootId].page,\r\n      page_size: replyPageInfo[rootId].page_size\r\n    })\r\n    // 适配后端数据结构\r\n    replyList.value[rootId] = res.list || []\r\n    replyPageInfo[rootId].total = res.total || 0\r\n    // 移除点赞状态初始化\r\n  } catch (err) {\r\n    if (!axios.isCancel(err)) {\r\n      console.error(`获取根评论${rootId}的回复失败：`, err)\r\n    }\r\n  }\r\n}\r\n\r\n// 发布根评论\r\nconst handlePublish = async () => {\r\n  if (!publishContent.value.trim()) {\r\n    return ElMessage.warning('评论内容不能为空')\r\n  }\r\n  if (!isLogin.value) {\r\n    return ElMessage.warning('请先登录')\r\n  }\r\n\r\n  isPublishing.value = true\r\n  try {\r\n    await request.post('/suggestion/publish', {\r\n      content: publishContent.value.trim()\r\n    })\r\n    ElMessage.success('评论发布成功')\r\n    publishContent.value = ''\r\n    // 发布成功后回到第一页并滚动到顶部\r\n    rootPageInfo.page = 1\r\n    await getRootComments()\r\n    window.scrollTo({ top: 0, behavior: 'smooth' })\r\n  } catch (err) {\r\n    if (!axios.isCancel(err)) {\r\n      console.error('发布评论失败：', err)\r\n    }\r\n  } finally {\r\n    isPublishing.value = false\r\n  }\r\n}\r\n\r\n// 切换回复面板显示\r\nconst toggleReplyPanel = (rootId) => {\r\n  showReplyId.value = rootId\r\n  if (rootId > 0) {\r\n    // 重置分页数据\r\n    if (replyPageInfo[rootId]) {\r\n      replyPageInfo[rootId].page = 1\r\n    }\r\n    getReplyList(rootId)\r\n    replyToUserId.value = ''\r\n    replyToUsername.value = ''\r\n  }\r\n  replyContent.value = ''\r\n}\r\n\r\n// 回复指定用户\r\nconst replyToUser = (replyId, userId, username) => {\r\n  replyToUserId.value = userId\r\n  replyToUsername.value = username\r\n  replyContent.value = `@${username} `\r\n  // 聚焦回复输入框\r\n  nextTick(() => {\r\n    const replyInput = document.querySelector('.reply-input .el-textarea__inner')\r\n    if (replyInput) replyInput.focus()\r\n  })\r\n}\r\n\r\n// 提交回复（新增：回复成功后重新拉取根评论，刷新回复数）\r\nconst handleReply = async (rootId) => {\r\n  if (!replyContent.value.trim()) {\r\n    return ElMessage.warning('回复内容不能为空')\r\n  }\r\n  if (!isLogin.value) {\r\n    return ElMessage.warning('请先登录')\r\n  }\r\n\r\n  isReplying.value = true\r\n  try {\r\n    await request.post('/suggestion/reply', {\r\n      parent_id: rootId,\r\n      reply_to_user_id: replyToUserId.value,\r\n      reply_to_username: replyToUsername.value,\r\n      content: replyContent.value.trim()\r\n    })\r\n    ElMessage.success('回复成功')\r\n    replyContent.value = ''\r\n    // 回复成功后重置分页并重新获取回复列表\r\n    replyPageInfo[rootId].page = 1\r\n    await getReplyList(rootId)\r\n    // 重新拉取根评论，刷新回复数\r\n    await getRootComments()\r\n    // 滚动到回复列表底部\r\n    nextTick(() => {\r\n      const replyList = document.querySelector(`.reply-list`)\r\n      if (replyList) {\r\n        replyList.scrollTop = replyList.scrollHeight\r\n      }\r\n    })\r\n  } catch (err) {\r\n    if (!axios.isCancel(err)) {\r\n      console.error('回复失败：', err)\r\n    }\r\n  } finally {\r\n    isReplying.value = false\r\n  }\r\n}\r\n\r\n// 显示编辑弹窗\r\nconst showUpdateDialog = (id, content) => {\r\n  updateCommentId.value = id\r\n  updateContent.value = content\r\n  updateDialogVisible.value = true\r\n}\r\n\r\n// 确认更新评论\r\nconst handleUpdateConfirm = async () => {\r\n  if (!updateContent.value.trim()) {\r\n    return ElMessage.warning('评论内容不能为空')\r\n  }\r\n  if (!isLogin.value) {\r\n    return ElMessage.warning('请先登录')\r\n  }\r\n\r\n  isUpdating.value = true\r\n  try {\r\n    await request.post('/suggestion/update', {\r\n      id: updateCommentId.value,\r\n      content: updateContent.value.trim()\r\n    })\r\n    ElMessage.success('评论修改成功')\r\n    updateDialogVisible.value = false\r\n    await getRootComments()\r\n  } catch (err) {\r\n    if (!axios.isCancel(err)) {\r\n      console.error('更新评论失败：', err)\r\n    }\r\n  } finally {\r\n    isUpdating.value = false\r\n  }\r\n}\r\n\r\n// 删除评论\r\nconst handleDelete = async (id) => {\r\n  try {\r\n    await ElMessageBox.confirm(\r\n      '确定要删除这条评论吗？删除后无法恢复',\r\n      '提示',\r\n      {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }\r\n    )\r\n    await request.post('/suggestion/delete', { id })\r\n    ElMessage.success('评论删除成功')\r\n    await getRootComments()\r\n  } catch (err) {\r\n    if (err !== 'cancel' && !axios.isCancel(err)) {\r\n      console.error('删除评论失败：', err)\r\n    }\r\n  }\r\n}\r\n\r\n// 根评论分页事件\r\nconst handleRootSizeChange = (val) => {\r\n  rootPageInfo.page_size = val\r\n  getRootComments()\r\n}\r\n\r\nconst handleRootPageChange = (val) => {\r\n  rootPageInfo.page = val\r\n  getRootComments()\r\n}\r\n\r\n// 回复分页事件\r\nconst handleReplySizeChange = (rootId, val) => {\r\n  replyPageInfo[rootId].page_size = val\r\n  getReplyList(rootId)\r\n}\r\n\r\nconst handleReplyPageChange = (rootId, val) => {\r\n  replyPageInfo[rootId].page = val\r\n  getReplyList(rootId)\r\n}\r\n\r\n// 跳转到登录页\r\nconst toLogin = () => {\r\n  router.push({ path: '/login', query: { redirect: route.fullPath } })\r\n}\r\n\r\n// 组件生命周期\r\nonMounted(() => {\r\n  // 监听localStorage变化\r\n  window.addEventListener('storage', handleStorageChange)\r\n  // 初始化获取评论\r\n  if (isLogin.value) {\r\n    getRootComments()\r\n  }\r\n})\r\n\r\nonUnmounted(() => {\r\n  // 移除监听\r\n  window.removeEventListener('storage', handleStorageChange)\r\n  // 取消所有pending请求\r\n  cancelSources.value.forEach(source => source.cancel('组件已卸载'))\r\n  cancelSources.value = []\r\n})\r\n</script>\r\n\r\n<style scoped>\r\n.comment-theme {\r\n  background: linear-gradient(135deg, #2c3e50 0%, #000000 100%);\r\n}\r\n\r\n.page-container {\r\n  min-height: 100vh;\r\n  color: white;\r\n}\r\n\r\n/* 登录提示 */\r\n.login-tip {\r\n  margin: 20px;\r\n  padding: 40px;\r\n  text-align: center;\r\n}\r\n\r\n.header {\r\n  background: rgba(255, 255, 255, 0.05);\r\n  backdrop-filter: blur(10px);\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 0 20px;\r\n}\r\n\r\n.left {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 20px;\r\n}\r\n\r\n.back-btn {\r\n  color: white !important;\r\n  font-size: 16px;\r\n}\r\n\r\n.main-content {\r\n  padding: 30px;\r\n  display: flex;\r\n  justify-content: center;\r\n}\r\n\r\n.comment-studio {\r\n  width: 100%;\r\n  max-width: 800px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 30px;\r\n}\r\n\r\n/* 玻璃拟态卡片 */\r\n.glass-card {\r\n  background: rgba(255, 255, 255, 0.08);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 20px;\r\n  padding: 30px;\r\n  border: 1px solid rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n/* 发布评论区域 */\r\n.input-section {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 20px;\r\n}\r\n\r\n.comment-input :deep(.el-textarea__wrapper) {\r\n  background: rgba(0,0,0,0.3);\r\n  border-radius: 15px;\r\n  box-shadow: none;\r\n  border: 1px solid #555;\r\n}\r\n\r\n.comment-input :deep(.el-textarea__inner) {\r\n  color: white;\r\n  font-size: 16px;\r\n  line-height: 1.5;\r\n}\r\n\r\n.publish-btn {\r\n  align-self: flex-end;\r\n  border-radius: 50px;\r\n  padding: 10px 30px;\r\n}\r\n\r\n/* 评论列表区域 */\r\n.comment-list {\r\n  min-height: 400px;\r\n}\r\n\r\n.root-comments {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 25px;\r\n}\r\n\r\n.root-comment-item {\r\n  padding-bottom: 20px;\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n.comment-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.username {\r\n  font-weight: 600;\r\n  color: #4facfe;\r\n}\r\n\r\n.create-time {\r\n  font-size: 12px;\r\n  color: #aeb6bf;\r\n}\r\n\r\n.comment-content {\r\n  line-height: 1.6;\r\n  margin-bottom: 15px;\r\n  font-size: 15px;\r\n}\r\n\r\n.comment-actions {\r\n  display: flex;\r\n  gap: 15px;\r\n  margin-bottom: 20px;\r\n  flex-wrap: wrap; /* 适配小屏幕 */\r\n}\r\n\r\n.comment-actions :deep(.el-button) {\r\n  color: #bdc3c7;\r\n}\r\n\r\n/* 删除点赞按钮相关样式 */\r\n.like-btn {\r\n  display: none;\r\n}\r\n\r\n/* 回复区域 */\r\n.reply-input-panel {\r\n  margin-top: 20px;\r\n  padding: 20px;\r\n  background: rgba(0,0,0,0.2);\r\n  border-radius: 15px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.reply-input {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.reply-input :deep(.el-textarea__wrapper) {\r\n  background: rgba(0,0,0,0.3);\r\n  border-radius: 10px;\r\n}\r\n\r\n.reply-actions {\r\n  display: flex;\r\n  gap: 10px;\r\n  justify-content: flex-end;\r\n}\r\n\r\n.reply-list {\r\n  margin-top: 20px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 20px;\r\n  padding-left: 20px;\r\n  border-left: 2px solid rgba(255, 255, 255, 0.1);\r\n  max-height: 400px; /* 限制高度，避免溢出 */\r\n  overflow-y: auto; /* 滚动条 */\r\n}\r\n\r\n.reply-item {\r\n  padding: 15px;\r\n  background: rgba(0,0,0,0.15);\r\n  border-radius: 10px;\r\n}\r\n\r\n.reply-header {\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.reply-username {\r\n  font-weight: 500;\r\n  color: #00f2fe;\r\n}\r\n\r\n.reply-to {\r\n  font-size: 12px;\r\n  color: #aeb6bf;\r\n  margin-left: 8px;\r\n}\r\n\r\n.reply-content {\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n/* 分页样式 */\r\n.root-pagination {\r\n  margin-top: 30px;\r\n  text-align: center;\r\n}\r\n\r\n.reply-pagination {\r\n  margin-top: 15px;\r\n  text-align: right;\r\n}\r\n\r\n:deep(.el-pagination) {\r\n  --el-pagination-text-color: white;\r\n}\r\n\r\n:deep(.el-pagination button) {\r\n  color: white !important;\r\n}\r\n\r\n/* 空状态 */\r\n.empty-comment {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  min-height: 200px;\r\n}\r\n\r\n/* 编辑弹窗 */\r\n.update-dialog :deep(.el-dialog) {\r\n  background: rgba(0,0,0,0.8);\r\n  backdrop-filter: blur(10px);\r\n  border: 1px solid rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n.update-dialog :deep(.el-dialog__header) {\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n.update-dialog :deep(.el-dialog__title) {\r\n  color: white;\r\n}\r\n\r\n.update-dialog :deep(.el-textarea__wrapper) {\r\n  background: rgba(0,0,0,0.3);\r\n  color: white;\r\n}\r\n\r\n/* 响应式适配 */\r\n@media (max-width: 768px) {\r\n  .main-content {\r\n    padding: 15px;\r\n  }\r\n  .glass-card {\r\n    padding: 20px;\r\n  }\r\n  .comment-actions {\r\n    gap: 10px;\r\n  }\r\n  .reply-list {\r\n    padding-left: 10px;\r\n  }\r\n}\r\n</style>"],"mappings":"AAgNA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,WAAW,EAAEC,QAAQ,EAAEC,QAAQ,QAAQ,KAAK;AAC/E,SAASC,SAAS,EAAEC,QAAQ,QAAQ,YAAY;AAChD,SAASC,SAAS,QAAQ,yBAAyB,EAAC;AACpD,SAASC,SAAS,EAAEC,YAAY,QAAQ,cAAc;AACtD,OAAOC,KAAK,MAAM,OAAO;;AAEzB;;;;;;;;IACA,MAAMC,MAAM,GAAGN,SAAS,CAAC,CAAC;IAC1B,MAAMO,KAAK,GAAGN,QAAQ,CAAC,CAAC;;IAExB;IACA,MAAMO,aAAa,GAAGd,GAAG,CAAC,EAAE,CAAC;;IAE7B;IACA,MAAMe,aAAa,GAAGA,CAAA,KAAM;MAC1B,MAAMC,OAAO,GAAGL,KAAK,CAACM,MAAM,CAAC;QAC3BC,OAAO,EAAE,MAAM;QACfC,OAAO,EAAE,KAAK;QACdC,OAAO,EAAE;UACP,cAAc,EAAE;QAClB;MACF,CAAC,CAAC;;MAEF;MACAJ,OAAO,CAACK,YAAY,CAACL,OAAO,CAACM,GAAG,CAC9BC,MAAM,IAAI;QACR;QACA,MAAMC,MAAM,GAAGb,KAAK,CAACc,WAAW,CAACD,MAAM,CAAC,CAAC;QACzCD,MAAM,CAACG,WAAW,GAAGF,MAAM,CAACG,KAAK;QACjCb,aAAa,CAACc,KAAK,CAACC,IAAI,CAACL,MAAM,CAAC;;QAEhC;QACA,MAAMM,QAAQ,GAAGC,IAAI,CAACC,KAAK,CAACC,YAAY,CAACC,OAAO,CAAC,UAAU,CAAC,IAAI,6BAA6B,CAAC;QAC9F,IAAIJ,QAAQ,CAACK,MAAM,IAAIL,QAAQ,CAACM,QAAQ,EAAE;UACxCb,MAAM,CAACH,OAAO,CAAC,WAAW,CAAC,GAAGU,QAAQ,CAACK,MAAM;UAC7CZ,MAAM,CAACH,OAAO,CAAC,YAAY,CAAC,GAAGU,QAAQ,CAACM,QAAQ;UAChDb,MAAM,CAACH,OAAO,CAAC,eAAe,CAAC,GAAG,SAAS,GAAGa,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC7E;QACA,OAAOX,MAAM;MACf,CAAC,EACDc,KAAK,IAAIC,OAAO,CAACC,MAAM,CAACF,KAAK,CAC/B,CAAC;;MAED;MACArB