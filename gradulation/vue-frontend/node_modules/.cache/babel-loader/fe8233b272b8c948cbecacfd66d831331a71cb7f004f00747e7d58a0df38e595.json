{"ast":null,"code":"import { ref } from 'vue';\nimport { ArrowLeft, EditPen, VideoPlay, Download, Share } from '@element-plus/icons-vue';\nimport { ElMessage } from 'element-plus';\nexport default {\n  __name: 'VideoGeneration',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const prompt = ref('');\n    const style = ref('realistic');\n    const duration = ref('3s');\n    const isGenerating = ref(false);\n    const progress = ref(0);\n    const resultVideo = ref('');\n    const handleGenerate = () => {\n      if (!prompt.value) return ElMessage.warning('请输入视频描述');\n      isGenerating.value = true;\n      progress.value = 0;\n      resultVideo.value = '';\n\n      // 模拟生成过程\n      const interval = setInterval(() => {\n        if (progress.value < 90) {\n          progress.value += Math.floor(Math.random() * 10);\n        }\n      }, 300);\n      setTimeout(() => {\n        clearInterval(interval);\n        progress.value = 100;\n        isGenerating.value = false;\n        // 这里放一个演示用的视频链接\n        resultVideo.value = 'https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4';\n        ElMessage.success('视频生成成功！');\n      }, 3000);\n    };\n    const __returned__ = {\n      prompt,\n      style,\n      duration,\n      isGenerating,\n      progress,\n      resultVideo,\n      handleGenerate,\n      ref,\n      get ArrowLeft() {\n        return ArrowLeft;\n      },\n      get EditPen() {\n        return EditPen;\n      },\n      get VideoPlay() {\n        return VideoPlay;\n      },\n      get Download() {\n        return Download;\n      },\n      get Share() {\n        return Share;\n      },\n      get ElMessage() {\n        return ElMessage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","ArrowLeft","EditPen","VideoPlay","Download","Share","ElMessage","prompt","style","duration","isGenerating","progress","resultVideo","handleGenerate","value","warning","interval","setInterval","Math","floor","random","setTimeout","clearInterval","success"],"sources":["C:/Users/11395/Desktop/design-graduation/gradulation/vue-frontend/src/views/VideoGeneration.vue"],"sourcesContent":["<template>\r\n  <div class=\"page-container\">\r\n    <!-- 顶部导航 -->\r\n    <el-header class=\"header\">\r\n      <div class=\"left\">\r\n        <el-button link @click=\"$router.back()\" class=\"back-btn\">\r\n          <el-icon><ArrowLeft /></el-icon> 返回\r\n        </el-button>\r\n        <h2>AI 视频生成</h2>\r\n      </div>\r\n    </el-header>\r\n\r\n    <el-main class=\"main-content\">\r\n      <div class=\"content-wrapper\">\r\n        <!-- 左侧：控制面板 -->\r\n        <div class=\"control-panel glass-card\">\r\n          <h3><el-icon><EditPen /></el-icon> 创作描述</h3>\r\n          <el-input\r\n            v-model=\"prompt\"\r\n            type=\"textarea\"\r\n            :rows=\"6\"\r\n            placeholder=\"例如：一只赛博朋克风格的猫在霓虹灯闪烁的雨夜街道上行走，超高清，电影质感...\"\r\n            class=\"custom-input\"\r\n          />\r\n          \r\n          <div class=\"settings-grid\">\r\n            <div class=\"setting-item\">\r\n              <span class=\"label\">风格</span>\r\n              <el-select v-model=\"style\" placeholder=\"选择风格\" class=\"custom-select\">\r\n                <el-option label=\"写实电影\" value=\"realistic\" />\r\n                <el-option label=\"3D 动画\" value=\"3d\" />\r\n                <el-option label=\"二次元\" value=\"anime\" />\r\n                <el-option label=\"水墨风\" value=\"ink\" />\r\n              </el-select>\r\n            </div>\r\n            <div class=\"setting-item\">\r\n              <span class=\"label\">时长</span>\r\n              <el-radio-group v-model=\"duration\" size=\"small\">\r\n                <el-radio-button label=\"3s\" />\r\n                <el-radio-button label=\"5s\" />\r\n                <el-radio-button label=\"10s\" />\r\n              </el-radio-group>\r\n            </div>\r\n          </div>\r\n\r\n          <el-button \r\n            type=\"primary\" \r\n            class=\"generate-btn\" \r\n            :loading=\"isGenerating\"\r\n            @click=\"handleGenerate\"\r\n          >\r\n            {{ isGenerating ? 'AI 正在渲染中...' : '开始生成视频' }}\r\n          </el-button>\r\n        </div>\r\n\r\n        <!-- 右侧：预览/结果区域 -->\r\n        <div class=\"preview-panel glass-card\">\r\n          <div v-if=\"!resultVideo && !isGenerating\" class=\"empty-state\">\r\n            <el-icon size=\"60\"><VideoPlay /></el-icon>\r\n            <p>生成的视频将在这里播放</p>\r\n          </div>\r\n\r\n          <div v-if=\"isGenerating\" class=\"loading-state\">\r\n            <div class=\"loader\"></div>\r\n            <p>正在根据文本构建画面... {{ progress }}%</p>\r\n          </div>\r\n\r\n          <div v-if=\"resultVideo\" class=\"video-result\">\r\n            <video controls autoplay loop :src=\"resultVideo\"></video>\r\n            <div class=\"actions\">\r\n              <el-button type=\"success\" icon=\"Download\" round>下载视频</el-button>\r\n              <el-button icon=\"Share\" circle></el-button> \r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </el-main>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref } from 'vue'\r\nimport { ArrowLeft, EditPen, VideoPlay, Download, Share } from '@element-plus/icons-vue'\r\nimport { ElMessage } from 'element-plus'\r\n\r\nconst prompt = ref('')\r\nconst style = ref('realistic')\r\nconst duration = ref('3s')\r\nconst isGenerating = ref(false)\r\nconst progress = ref(0)\r\nconst resultVideo = ref('')\r\n\r\nconst handleGenerate = () => {\r\n  if (!prompt.value) return ElMessage.warning('请输入视频描述')\r\n  \r\n  isGenerating.value = true\r\n  progress.value = 0\r\n  resultVideo.value = ''\r\n\r\n  // 模拟生成过程\r\n  const interval = setInterval(() => {\r\n    if (progress.value < 90) {\r\n      progress.value += Math.floor(Math.random() * 10)\r\n    }\r\n  }, 300)\r\n\r\n  setTimeout(() => {\r\n    clearInterval(interval)\r\n    progress.value = 100\r\n    isGenerating.value = false\r\n    // 这里放一个演示用的视频链接\r\n    resultVideo.value = 'https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4'\r\n    ElMessage.success('视频生成成功！')\r\n  }, 3000)\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* 复用之前的背景风格 */\r\n.page-container {\r\n  min-height: 100vh;\r\n  background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);\r\n  color: white;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.header {\r\n  background: rgba(0, 0, 0, 0.2);\r\n  backdrop-filter: blur(10px);\r\n  display: flex;\r\n  align-items: center;\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n.back-btn {\r\n  color: white;\r\n  font-size: 16px;\r\n  margin-right: 20px;\r\n}\r\n\r\n.content-wrapper {\r\n  display: flex;\r\n  gap: 30px;\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.glass-card {\r\n  background: rgba(255, 255, 255, 0.1);\r\n  backdrop-filter: blur(20px);\r\n  border-radius: 16px;\r\n  padding: 30px;\r\n  border: 1px solid rgba(255, 255, 255, 0.2);\r\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n/* 左侧面板 */\r\n.control-panel {\r\n  flex: 1;\r\n  min-width: 300px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 20px;\r\n}\r\n\r\n.control-panel h3 {\r\n  margin: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.settings-grid {\r\n  display: flex;\r\n  gap: 20px;\r\n}\r\n\r\n.setting-item {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.generate-btn {\r\n  margin-top: 20px;\r\n  height: 50px;\r\n  font-size: 18px;\r\n  background: linear-gradient(90deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);\r\n  border: none;\r\n  color: #333;\r\n  font-weight: bold;\r\n}\r\n.generate-btn:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 5px 15px rgba(255, 154, 158, 0.4);\r\n}\r\n\r\n/* 右侧面板 */\r\n.preview-panel {\r\n  flex: 1.5;\r\n  min-width: 300px;\r\n  min-height: 400px;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  background: rgba(0,0,0,0.3);\r\n  position: relative;\r\n}\r\n\r\n.empty-state {\r\n  text-align: center;\r\n  color: rgba(255,255,255,0.5);\r\n}\r\n\r\n.video-result {\r\n  width: 100%;\r\n  height: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n}\r\n\r\nvideo {\r\n  width: 100%;\r\n  border-radius: 8px;\r\n  max-height: 350px;\r\n  object-fit: cover;\r\n  box-shadow: 0 10px 30px rgba(0,0,0,0.5);\r\n}\r\n\r\n.actions {\r\n  margin-top: 20px;\r\n  display: flex;\r\n  gap: 15px;\r\n}\r\n\r\n/* 简单的Loading动画 */\r\n.loader {\r\n  width: 48px;\r\n  height: 48px;\r\n  border: 5px solid #FFF;\r\n  border-bottom-color: transparent;\r\n  border-radius: 50%;\r\n  display: inline-block;\r\n  box-sizing: border-box;\r\n  animation: rotation 1s linear infinite;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n@keyframes rotation {\r\n  0% { transform: rotate(0deg); }\r\n  100% { transform: rotate(360deg); }\r\n}\r\n\r\n/* 覆盖Element UI 样式以适应暗色背景 */\r\n:deep(.el-textarea__inner), :deep(.el-input__wrapper) {\r\n  background: rgba(0,0,0,0.2) !important;\r\n  box-shadow: none !important;\r\n  color: white !important;\r\n  border: 1px solid rgba(255,255,255,0.2);\r\n}\r\n</style>"],"mappings":"AAiFA,SAASA,GAAG,QAAQ,KAAK;AACzB,SAASC,SAAS,EAAEC,OAAO,EAAEC,SAAS,EAAEC,QAAQ,EAAEC,KAAK,QAAQ,yBAAyB;AACxF,SAASC,SAAS,QAAQ,cAAc;;;;;;;IAExC,MAAMC,MAAM,GAAGP,GAAG,CAAC,EAAE,CAAC;IACtB,MAAMQ,KAAK,GAAGR,GAAG,CAAC,WAAW,CAAC;IAC9B,MAAMS,QAAQ,GAAGT,GAAG,CAAC,IAAI,CAAC;IAC1B,MAAMU,YAAY,GAAGV,GAAG,CAAC,KAAK,CAAC;IAC/B,MAAMW,QAAQ,GAAGX,GAAG,CAAC,CAAC,CAAC;IACvB,MAAMY,WAAW,GAAGZ,GAAG,CAAC,EAAE,CAAC;IAE3B,MAAMa,cAAc,GAAGA,CAAA,KAAM;MAC3B,IAAI,CAACN,MAAM,CAACO,KAAK,EAAE,OAAOR,SAAS,CAACS,OAAO,CAAC,SAAS,CAAC;MAEtDL,YAAY,CAACI,KAAK,GAAG,IAAI;MACzBH,QAAQ,CAACG,KAAK,GAAG,CAAC;MAClBF,WAAW,CAACE,KAAK,GAAG,EAAE;;MAEtB;MACA,MAAME,QAAQ,GAAGC,WAAW,CAAC,MAAM;QACjC,IAAIN,QAAQ,CAACG,KAAK,GAAG,EAAE,EAAE;UACvBH,QAAQ,CAACG,KAAK,IAAII,IAAI,CAACC,KAAK,CAACD,IAAI,CAACE,MAAM,CAAC,CAAC,GAAG,EAAE,CAAC;QAClD;MACF,CAAC,EAAE,GAAG,CAAC;MAEPC,UAAU,CAAC,MAAM;QACfC,aAAa,CAACN,QAAQ,CAAC;QACvBL,QAAQ,CAACG,KAAK,GAAG,GAAG;QACpBJ,YAAY,CAACI,KAAK,GAAG,KAAK;QAC1B;QACAF,WAAW,CAACE,KAAK,GAAG,0EAA0E;QAC9FR,SAAS,CAACiB,OAAO,CAAC,SAAS,CAAC;MAC9B,CAAC,EAAE,IAAI,CAAC;IACV,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}